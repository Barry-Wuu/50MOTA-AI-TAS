_global.calcDamage = function(icon_no)
{
   if(icon_no < 0 || icno > 50)
   {
      return undefined;
   }
   with(_global.Enemy_array[icon_no])
   {
      if(Cross && _global.Player.Cowrys.Cross || Dragon && _global.Player.Cowrys.Dragon)
      {
         PlayerOffense = _global.Player.Offense + _global.Player.Offense - Defense;
         EnemyOffense = Offense - _global.Player.Defense;
      }
      else
      {
         PlayerOffense = _global.Player.Offense - Defense;
         EnemyOffense = Offense - _global.Player.Defense;
      }
      if(EnemyOffense < 1)
      {
         EnemyOffense = 0;
         Damage = 0;
      }
      if(PlayerOffense < 1)
      {
         PlayerOffense = 0;
         Damage = -1;
      }
      if(PlayerOffense > 0 && EnemyOffense > 0)
      {
         Damage = (Math.ceil(Life / PlayerOffense) - 1) * EnemyOffense;
      }
   }
};
_global.calcMagicDamage = function()
{
   var _loc2_ = _global;
   var _loc3_ = new Array(0,0,0,0);
   var _loc1_ = 0;
   var life = _loc2_.Player.Life;
   _loc2_.CurEnemy.MagicDamage = 0;
   _loc2_.CurEnemy.MagicUp = false;
   _loc2_.CurEnemy.MagicDown = false;
   _loc2_.CurEnemy.MagicLeft = false;
   _loc2_.CurEnemy.MagicRight = false;
   if(!(!_loc2_.CurMagicDamage || !_loc2_.Player.MagicDamage))
   {
      if(_loc2_.CurEnemy.CurUpNo >= 0)
      {
         _loc3_[0] = _loc2_.CurObj_array[_loc2_.CurEnemy.CurUpNo].IconNo;
      }
      if(_loc2_.CurEnemy.CurDownNo >= 0)
      {
         _loc3_[1] = _loc2_.CurObj_array[_loc2_.CurEnemy.CurDownNo].IconNo;
      }
      if(_loc2_.CurEnemy.CurLeftNo >= 0)
      {
         _loc3_[2] = _loc2_.CurObj_array[_loc2_.CurEnemy.CurLeftNo].IconNo;
      }
      if(_loc2_.CurEnemy.CurRightNo >= 0)
      {
         _loc3_[3] = _loc2_.CurObj_array[_loc2_.CurEnemy.CurRightNo].IconNo;
      }
      _loc1_ = 0;
      while(_loc1_ < 4)
      {
         if(_loc3_[_loc1_] > 0 && _loc3_[_loc1_] < 50)
         {
            _loc3_[_loc1_] = _loc2_.Enemy_array[_loc3_[_loc1_]].Magic;
         }
         else
         {
            _loc3_[_loc1_] = 0;
         }
         _loc1_ = _loc1_ + 1;
      }
      if(_loc3_[0] == -50 && _loc3_[1] == -50)
      {
         life = (life + life % 2) / 2;
         _loc2_.CurEnemy.MagicUp = true;
         _loc2_.CurEnemy.MagicDown = true;
      }
      if(_loc3_[2] == -50 && _loc3_[3] == -50)
      {
         life = (life + life % 2) / 2;
         _loc2_.CurEnemy.MagicLeft = true;
         _loc2_.CurEnemy.MagicRight = true;
      }
      _loc1_ = 0;
      while(_loc1_ < 4)
      {
         if(_loc3_[_loc1_] > 0)
         {
            life -= _loc3_[_loc1_];
            switch(_loc1_)
            {
               case 0:
                  _loc2_.CurEnemy.MagicUp = true;
                  break;
               case 1:
                  _loc2_.CurEnemy.MagicDown = true;
                  break;
               case 2:
                  _loc2_.CurEnemy.MagicLeft = true;
                  break;
               case 3:
                  _loc2_.CurEnemy.MagicRight = true;
            }
         }
         _loc1_ = _loc1_ + 1;
      }
      _loc2_.CurEnemy.MagicDamage = _loc2_.Player.Life - life;
   }
};
