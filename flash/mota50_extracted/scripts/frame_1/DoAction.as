_global.ExchangeYes_onPress = function()
{
   var exchange_allow = true;
   with(_global.Exchange_array[_global.ExchangeNo])
   {
      if(- Life >= _global.Player.Life)
      {
         exchange_allow = false;
         _global.Msg_dsp("你的生命点数太低");
      }
      if(- Offense > _global.Player.Offense)
      {
         exchange_allow = false;
         _global.Msg_dsp("你的攻击点数太低");
      }
      if(- Defense > _global.Player.Defense)
      {
         exchange_allow = false;
         _global.Msg_dsp("你的防御点数太低");
      }
      if(- Money > _global.Player.Money)
      {
         exchange_allow = false;
         _global.Msg_dsp("你的钱不够");
      }
      if(- KeyYellow > _global.Player.KeyYellow)
      {
         exchange_allow = false;
         _global.Msg_dsp("你的黄钥匙数量不够");
      }
      if(- KeyBlue > _global.Player.KeyBlue)
      {
         exchange_allow = false;
         _global.Msg_dsp("你的兰钥匙数量不够");
      }
      if(- KeyRed > _global.Player.KeyRed)
      {
         exchange_allow = false;
         _global.Msg_dsp("你的红钥匙数量不够");
      }
      if(exchange_allow)
      {
         _global.CurObj_array[_global.EndGridNo].EventNo = EventNo;
         if(EventNo == 0)
         {
            _global.CurObj_array[_global.EndGridNo].IconNo = 0;
            _global.Icon_mc_play(_global.EndGridNo);
         }
         _global.Player.Life += life;
         _global.Player.Offense += Offense;
         _global.Player.Defense += Defense;
         _global.Player.Money += Money;
         _global.Player.KeyYellow += KeyYellow;
         _global.Player.KeyBlue += KeyBlue;
         _global.Player.KeyRed += KeyRed;
         if(IconNo > 0)
         {
            _global.Player_onGetting(IconNo);
         }
         _global.Player_dspInfo(_global.Player);
      }
   }
   _global.Exchange_mc_hide();
};
