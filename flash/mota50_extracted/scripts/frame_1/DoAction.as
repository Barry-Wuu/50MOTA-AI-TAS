_global.CurEnemy_set = function(grid_no)
{
   _global.CurEnemy.GridNo = grid_no;
   _global.CurEnemy.IconNo = _global.CurObj_array[grid_no].IconNo;
   _global.CurEnemy.EventNo = _global.CurObj_array[grid_no].EventNo;
   if(_global.CurEnemy.GridNo > 10)
   {
      _global.CurEnemy.CurUpNo = _global.CurEnemy.GridNo - 11;
   }
   else
   {
      _global.CurEnemy.CurUpNo = -1;
   }
   if(_global.CurEnemy.GridNo < 110)
   {
      _global.CurEnemy.CurDownNo = _global.CurEnemy.GridNo + 11;
   }
   else
   {
      _global.CurEnemy.CurDownNo = -1;
   }
   if(_global.CurEnemy.GridNo % 11 > 0)
   {
      _global.CurEnemy.CurLeftNo = _global.CurEnemy.GridNo - 1;
   }
   else
   {
      _global.CurEnemy.CurLeftNo = -1;
   }
   if(_global.CurEnemy.GridNo % 11 < 10)
   {
      _global.CurEnemy.CurRightNo = _global.CurEnemy.GridNo + 1;
   }
   else
   {
      _global.CurEnemy.CurRightNo = -1;
   }
   _global.calcMagicDamage();
   if(_global.CurEnemy.IconNo < 1 || _global.CurEnemy.IconNo > 50)
   {
      _global.CurEnemy.Name = "";
      _global.CurEnemy.Life = 0;
      _global.CurEnemy.Offense = 0;
      _global.CurEnemy.Defense = 0;
      _global.CurEnemy.Money = 0;
      _global.CurEnemy.PlayerOffense = 0;
      _global.CurEnemy.EnemyOffense = 0;
      _global.CurEnemy.Damage = 0;
   }
   else
   {
      _global.calcDamage(_global.CurEnemy.IconNo);
      with(_global.Enemy_array[_global.CurEnemy.IconNo])
      {
         _global.CurEnemy.Name = Name;
         _global.CurEnemy.Life = Life;
         _global.CurEnemy.Offense = Offense;
         _global.CurEnemy.Defense = Defense;
         if(_global.Player.Cowrys.Luck)
         {
            _global.CurEnemy.Money = Money + Money;
         }
         else
         {
            _global.CurEnemy.Money = Money;
         }
         _global.CurEnemy.PlayerOffense = PlayerOffense;
         _global.CurEnemy.EnemyOffense = EnemyOffense;
         _global.CurEnemy.Damage = Damage;
      }
   }
   if(_global.CurEnemy.Damage < 0)
   {
      _global.CurEnemy.Fight = false;
      _global.CurEnemy.Msg_str = Name + " 的防御太高，不可攻击";
   }
   else if(_global.CurEnemy.Damage + _global.CurEnemy.MagicDamage >= _global.Player.Life)
