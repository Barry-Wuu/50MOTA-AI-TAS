    #   触发后英雄停在 (10,11) 不移动。原 goto(11,11) 会在此之后又真踏一格到 (11,11)
    #   再折回。改为走到 (10,11) 后手动朝 (1,0) 触发购物（不移动），省掉踏入+折回两步。
    if not goto(w, 10, 11, 'V25 15F 商店邻格(10,11)'): return 1
    # 直接调用引擎 move 一次（勿用 _step：它见原地不动会补走一次 → 反踏 (11,11)）。
    # 购物分支 return log 不移动英雄，停在 (10,11)，省掉原 goto(11,11) 的踏入+折回两步。
    _lg = w.move(1, 0)            # 朝 (11,11) 商店触发购物，英雄仍停 (10,11)
    if not _lg or not any('购物 obj159' in s for s in _lg):
        print('  !! V25 15F 购物失败:', _lg); return 1
    if not goto(w, 7, 11, 'V25 15F 回楼梯旁(7,11)'): return 1
    if not run_segs.fly(w, 20, 'V25 15F->20F'): return 1

    print()
    print('=== 到达 20F（V25 完成）:', st(h))

    # ---------- V26: 20F 首访（line232）——左下高级法师 → 血瓶 → 黄门打蝙蝠 → 黄钥+红蓝宝石 → 下 18F ----------
    # 攻略 line232：左下打高级法师（L≈182）→ 拿血瓶 → 向上过黄门打蝙蝠（不伤）
    #   → 拿钥匙 + 红/蓝宝石（A72/D82）→ 下 18F。
    # PC-98 坐标：上級僧侶(4,11) → 红药(1,11) → 黄门(1,9) → バット(1,7) 不伤
    #   → 蓝门(2,6) → 黄钥(1,5) → 青晶(1,4) D+2 → 赤晶(2,4) A+2。
    # ⚠️ 黄钥(1,5)/青晶(1,4)/赤晶(2,4) 所在小室被 (1,2)(1,3)(1,6) 三面墙围死，
    #   唯一入口是蓝门 (2,6) → 本段必须 1 把蓝钥。
    # 蓝钥缺口：1 区把 6F 50G 蓝钥用在 7F(5,5) 蓝门（攻略未列该门），此刻蓝0 < 攻略1。
    #   按攻略价目表「15F 商人 蓝钥匙 200G，很赚，推荐买」补购：飞 15F → 成交 → 飞回 20F
    #   （飞行之珠须在楼梯旁使用：19F(6,10) 邻 (6,11)、15F(6,10) 邻 (6,11)，均满足）。
