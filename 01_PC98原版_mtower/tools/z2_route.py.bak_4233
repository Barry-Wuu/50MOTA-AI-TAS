    #   此刻蓝钥 0，唯一来源 14F(1,11)（line281 之前未动）→ 先飞 14F 取蓝钥再回 20F。
    #   （32F(11,7)/(4,8) 两把蓝钥在右侧骑士区，被 ATK230 騎士(8,7) 挡，此时打不过，不能用。）
    # PC-98 关键差异 2：32F 右下鬼战士 (8,11) 与右上鬼战士 (8,4) 均为 obj94 死霊兵士 HP220 ATK180
    #   DEF30。十字架 obj103 对死霊兵士**不生效**（mult 只对 obj{48,49,59} 与 obj74 屠龙匕生效，
    #   见 mota_core battle() line500），故 A78 D90 时 per=48、turns=5、loss=(180-90)*4=360；
    #   右上时 A86 D122：per=56、turns=4、loss=(180-122)*3=174。
    # PC-98 坐标 32F：下梯(6,11)、上梯(11,1)；祭坛(10,10)，唯一可站邻格(10,11)（(9,10)=obj21、(11,10)=obj23
    #   祭坛侧翼不可入，(10,9) 墙）；右下死霊(8,11)、右上死霊(8,4)；黄门(7,3)→(8,3)→(8,4)；
    #   (9,5) 黄门→(10,5)→(10,4)黄钥→(11,4)血瓶800→(11,5)黄钥。左区黄门(1,3)/(5,3) 暂不开（属 V46+）。
    # 20F 坐标：下梯(6,11)、蓝门(10,6)→(10,5)→(10,4)赤薬+50→(11,4)青薬+400→(11,5)黄钥；左下石头人 (2,10)。
    # 19F 坐标：上梯(6,11)、下梯(1,1)；堵门兽人武士 (6,9)（x=6 列上梯正上方，正是「堵门」）。
    # 14F 坐标：上梯(6,11)、下梯(11,11)；蓝钥(1,11)；黄门(4,11) 拦路需 1 黄钥。
    # 祭坛账：V44 末 **altar_k=5（实测）**——1区 run_segs.main() 的 4F 祭坛 1 次 + V2 2防 + V10 1攻
    #   + V13 1攻（均 12F）。本段 k=5→320G、k=6→440G（2 次防），k=7→580G（1 次攻），共 1340G，
    #   比旧注释（按 k=4 算的 980G）多 360G → 208G 缺口由 ⑥b 刷金补齐（16F+18F 共 220G）。
    # 钥匙账：+1 蓝钥（14F）→ 20F 蓝门(10,6) -1；19F 黄门(4,11) -1 黄钥；20F(11,5) +1 黄钥、
    #   32F(10,4)(11,5) +2 黄钥 → 黄钥净 +1。蓝钥：⑥b 顺路取 18F(11,3) +1，本段净 +1，
    #   留作 V46 开 33F(4,11) 蓝门（-1）。⑥b 除该蓝钥外不开门、不拾其它道具。
    # 金币账（按实测推演）：G992 +22+25(①②途中 A* 顺路杀) +35(右下死霊)=G1074 → -320(k=5)=G754
    #   → -440(k=6)=G314 → +28(左下ロック)=G342 → +30(19F ゾンビナイト)=G372 → +220(⑥b 16F+18F 刷金)
    #   =G592 → -580(k=7)=G12 → +35(右上死霊)=G47。终 G47。
    # HP 账：HP891 +50(20F 赤薬)=941 +400(20F 青薬)=1341 -360(右下死霊)=981 -0(ロック)=981 -0(ゾンビナイト)
    #   =981 -174(右上死霊)=807 +800(32F 青薬)=1607。终 HP1607 A86 D122。
    # 飞行落点：14F→(10,11)、20F→(6,10)、19F→(1,2)、32F→(6,10)；须贴梯使用：32F(6,10)邻(6,11)、
    #   14F(6,10)邻(6,11)、20F(6,10)邻(6,11)、19F(6,10)邻(6,11)（贴上行梯）。
    print('--- V45 32F（line276，右下死霊→2防→20F石头人→19F兽人武士→1攻→右上死霊→上楼）---')
    # ① 跳过 14F 补蓝钥
    #   本段不再重取（该格已 cleared）。20F 血瓶也已在 V33 取走，故本段直接从 32F 开工。

    # ② 跳过 20F 两血瓶
    #   全部取走，且 20F 蓝门(10,6) 已开、格子已 cleared —— 本段无需重访。
    #   血量核对：V33 结束 HP866、A78/D90；本段要打两次死霊兵士
    #   （右下 -360 @A78/D90、右上 -174 @A86/D122）合计 -534，866 足够，不需那 +450。

    # ③ 硬拼右下鬼战士 (8,11)：32F 从 (6,10) 下到底廊向东
    if not run(w, [
        (7, 10, ''),
        (7, 11, ''),
        (8, 11, '死霊兵士'),          # 右下鬼战士 -360（A78 D90，十字架不生效）
    ], 'V45'): return 1
    # ④ 祭坛升 2 次防（k=5→320G、k=6→440G）：邻格 (10,11)
    if not run(w, [
        (9, 11, ''),
        (10, 11, ''),                 # 祭坛唯一可站邻格
    ], 'V45'): return 1
    if not altar_uses(w, 10, 10, 2, 'dfn', 'V45'): return 1

    #   obj56 +28G 改由 V69 20F 左袋去程 (2,11)↑(2,10) 顺路补拿，此处 32F 直接 fly16。
    #   原再多走 (7,10)→(6,10) 是同梯换边，直接在 (7,11) 飞。
