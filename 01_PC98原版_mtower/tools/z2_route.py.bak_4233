    #   (3,5)(4,5)(5,5)(7,5)(8,5)(9,5) 全清 → slime30=True → 落穴消失，(6,1) 现上行梯。
    #   当前 A78 D90，六只史莱姆 ATK 最大 60（Ｂスライム）≤ 90=D → 全部不血刃。
    # PC-98 坐标：30F 落点(6,10)，环内触发格(6,6)，六只史莱姆在 y=5 行。
    #   路线：落点(6,10)→(6,9)→(6,8)→(6,7)→(6,6) 踩触发封环 → 清 y=5 行六只史莱姆
    #   （左半 (6,6)→(5,6)→(5,5)Ｇ→(4,5)Ｒ→(3,5)Ｂ→回；右半 (6,6)→(7,6)→(7,5)Ｇ→(8,5)Ｒ→(9,5)Ｂ→回）
    #   → slime30=True → (6,4)(6,7) 复通、(6,1) 现上行梯 → 走到上梯邻格(6,2) → stair() 上 31F。
    print('--- V34 30F（line261，六只史莱姆不血刃→上楼）---')
    #    右半清完也不回环心，直接经 (6,5)(6,4)(6,3) 上到 (6,2)。
    #    封环只封 (6,4)(6,7) 两格为落穴，y=5 走廊 (6,5) 始终可走 → 省 4 步。
    if not run(w, [
        (6, 6, '踩(6,6)触发封环'),
        (5, 5, 'Ｇスライム(5,5)'),
        (4, 5, 'Ｒスライム(4,5)'),
        (3, 5, 'Ｂスライム(3,5)'),
        (7, 5, 'Ｇスライム(7,5)'),
        (8, 5, 'Ｒスライム(8,5)'),
        (9, 5, 'Ｂスライム(9,5)'),
    ], 'V34'): return 1
    if not run_segs.stair(w, 6, 1, '30F(6,1)->31F'): return 1

    print()
    print('=== 到达 31F（V34 完成）:', st(h))

    # ---------- V44: 31F（line275）——向下打 2 个兽人武士 → 上楼 → 32F ----------
