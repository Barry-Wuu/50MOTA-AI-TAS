        (6, 9, ''), (6, 10, ''), (5, 10, ''), (4, 10, ''), (3, 10, ''),
        (2, 10, ''), (2, 9, ''), (2, 8, ''), (2, 7, ''), (2, 6, ''),
        (3, 6, 'ロック+28'),
