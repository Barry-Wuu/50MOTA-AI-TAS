        (8, 1,  '凿开后(8,1)'),
        (7, 1,  ''),
        (7, 2,  ''),                  # 绕开 (6,1) 上行梯，走 y2 进左区
        (6, 2,  ''),
        (5, 2,  ''),
        (5, 1,  ''),
        (4, 1,  '黄门(4,1) 进左区'),
        (3, 1,  ''),
        (3, 2,  ''),
        (3, 3,  'Ｂスライム'),
        (2, 3,  ''),
        (1, 3,  ''),
        (1, 4,  '黄门(1,4)'),
        (1, 5,  ''),
        (1, 6,  ''),
        (1, 7,  'Ｂスライム'),
        (1, 8,  ''),
        (1, 9,  ''),
        (2, 9,  '黄门(2,9)'),
        (3, 9,  ''),
        (3, 8,  ''),
        (3, 7,  '黄钥(3,7)'),
        (3, 6,  '★蓝钥匙(3,6)'),
        (3, 5,  '黄钥(3,5)（原V29单独跑一趟，改此处顺便拾）'),
        (3, 6,  ''),
        (3, 7,  ''),
        (3, 8,  ''),
        (3, 9,  ''),
        (2, 9,  ''),
        (1, 9,  ''),
        (1, 8,  ''),
        (1, 7,  ''),
        (1, 6,  ''),
        (1, 5,  ''),
        (1, 4,  ''),
        (1, 3,  ''),
        (2, 3,  ''),
        (3, 3,  ''),
        (3, 2,  ''),
        (3, 1,  ''),
        (4, 1,  ''),
        (5, 1,  ''),
    ], 'V6 取15F蓝钥'): return 1
    if not stair(w, 6, 1, 'V6 15F->16F（提前取剑）'): return 1
    # 16F 穿行：蓝门(6,4) → 绕兽人武士(6,6) 走 x7 列 → 黄门(6,8) → 上行梯(6,11)
    if not run(w, [
        (6, 3,  ''),
        (6, 4,  '蓝门(6,4)'),
        (6, 5,  ''),
        #   此处「<>」顺手取掉（+100HP），V8 不再专程绕回取它。
        (5, 5,  '血瓶+100（<> 顺路取，原 V8 折返）'),
        (6, 5,  ''),
        (7, 5,  ''),
        (7, 6,  ''),
        (6, 7,  ''),
        (6, 8,  '黄门(6,8)'),
        (6, 9,  ''),
    ], 'V6 16F 穿行'): return 1
    if not stair(w, 6, 11, 'V6 16F->17F（提前取剑）'): return 1
    # 17F 左区取银剑（原 V9 首段整体前移；A30 时大バット -100）
    if not run(w, [
        (5, 10, ''),
        (5, 11, ''),
        (4, 11, '大バット'),
        (1, 11, '血瓶+100'),
        (2, 11, ''),
        (2, 11, '黄门(2,10)'),
        (2, 10, ''),
        (2, 9,  ''),
        (1, 9,  ''),
        (1, 8,  '門番Ｃ 无伤'),
        (2, 8,  ''),
        (3, 8,  '門番Ｃ 无伤'),
        (2, 8,  ''),
