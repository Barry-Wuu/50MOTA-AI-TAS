    if not goto_stair_adj(w, 'V4 回梯旁'): return 1
    #   这样 15F 提前"到过"一次，后面 V5 尾巴就能从 11F 直飞 15F（落 (6,10)），不必绕 14F。
    if not stair(w, 6, 11, 'V4 14F->15F（下一步）'): return 1
    if not fly(w, 11, 'V4 15F→11F（飞行之珠）'): return 1

    # ---------- V5: 11F 进黄门打大史莱姆 → 拾左下5把黄钥 → 回14F直接上楼 ----------
    print('--- V5 11F（line211，拾左下5把黄钥）---')
    # 攻略：走到去10F楼梯左侧，进黄门打大史莱姆。11F 大史莱姆 (4,9)（黄门(5,9)）。
    #   打完后顺路拾左下 5 把黄钥 (1,10)(1,11)(2,11)(3,11)(4,11)——这是后续黄门账的关键来源。
    if not run(w, [
        (4, 9,  'Ｂスライム'),       # (4,9) 大史莱姆（黄门(5,9) 顺路开）
        (3, 9,  ''),
        (3, 10, ''),
        (2, 10, ''),
        (1, 10, '黄钥'),
        (1, 11, '黄钥'),
        (2, 11, '黄钥'),
        (3, 11, '黄钥'),
        (4, 11, '黄钥'),
        #   原 (3,10)(3,9) 的折返纯属绕行（(4,9) 的大史莱姆已在去程打掉）。
        (4, 10, '回 y10'),
        (4, 9,  ''),
        (5, 9,  ''),
        #   在 (6,9) 直接下一步到 (6,10)（贴着下行梯(6,11)），就地飞 15F（落点同为 (6,10)）。
