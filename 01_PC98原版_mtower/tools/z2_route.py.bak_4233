    print('=== 到达 40F（V67 完成）:', st(h))
    if os.environ.get('MOTA_AUDIT_GEMS'):
        print('=== V67 后：1-40F 未拾取的属性宝石（ATK/DEF）===')
        for _f in range(1, 41):
            for _x in range(1, 12):
                for _y in range(1, 12):
                    _o = w.at(_f, _x, _y)
                    if not _o:
                        continue
                    _a = M.OA[_o]
                    if M.TYPE.get(M.oatr(_o, 3)) == 'STATUS' and (_a[11] > 0 or _a[12] > 0):
                        print('  %dF(%2d,%2d) obj%-4d %-14s ATK+%s DEF+%s'
                              % (_f, _x, _y, _o, M.oname(_o)[:14], _a[11], _a[12]))
        return 0
    pf = os.environ.get('MOTA_PROBE_FLOOR')
    if pf:
        for _pf in pf.split(','):
            _dump_floor(w, int(_pf))

    # ---------- V68: 40F（line300）——双手剑士→过红门→(6,7) 触发 13 波围杀→拾战利品→飞 31F ----------
    #   起点 40F(10,11)（V67 落点），邻下行梯(11,11)。
    #   40F 血瓶(9,9) 已在 V65 拿过（攻略「拿血瓶」提前完成），本段无需重复。
    #   ① 打双手剑士(10,9)：A151-D50=101，1回合秒杀，0伤 +55G。
    #   ② 过红门(6,8)：红钥1→0（BOSS_DOOR_CELLS 含 (40,6,8)）。
    #      「13 步、分别被 13 只怪打」）：死霊兵士(3,4)(4,4)(5,4) → 兵士(7,4)(8,4)(9,4)
    #      → 剣士(2,2)(3,2)(4,2) → 騎士(8,2)(9,2)(10,2) → 金騎士(6,2)，各按原作 moveChara
