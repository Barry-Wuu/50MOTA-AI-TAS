    ], 'V5'): return 1
    # 回 14F 上楼：11F(11,11)->12F(11,11)->13F(1,11)->14F
    #   改为站 11F 梯旁直接飞 14F（落点 (10,11) 即 14F 上行梯踏出格）。
    if not goto_stair_adj(w, 'V5 回梯旁'): return 1
    if not fly(w, 15, 'V5 11F→15F（飞行之珠）'): return 1

    # ---------- V6: 15F 向右过黄门打蝙蝠 → 向上过两黄门打大蝙蝠 → 向右过黄门打大史莱姆 → 小偷 → 下12F ----------
    print('--- V6 15F（line212）---')
    if not run(w, [
        (9, 10, ''),                  # 先东行到右区
        (9, 9,  '黄门(9,9)'),
        (9, 4,  '大バット'),          # (9,4) obj47 大蝙蝠
        (11, 3, '黄门(11,3)'),
        (11, 2, 'Ｂスライム'),        # (11,2) 大史莱姆（向右过黄门打大史莱姆）
        (9, 1,  '★盗贼：凿开(8,1)'),  # (9,1) obj88 小偷
    ], 'V6'): return 1
    #   银剑 ATK+20 让后面 12F ゾンビ(-350→-175)、16F 大バット(×2)/Ｂスライム(×2)、
    #   17F/18F 全部战斗按 ATK50+ 结算，正是 20F BOSS 前血量缺口的关键。
    #   ⚠️ 此时 kb=0，16F 蓝门(6,4) 进不去 → 先取 **15F 左区 (3,6) 蓝钥匙**：
    #      入口 (4,1)黄门 → (3,3)Ｂスライム → (1,4)黄门 → (1,7)Ｂスライム → (2,9)黄门 → (3,6)。
    #      代价 2×Ｂスライム(-40×2) + 3 黄钥，回程拾 (3,7) 黄钥 1 把。
