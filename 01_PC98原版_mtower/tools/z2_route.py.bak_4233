    #   ⑤ 回楼梯旁(10,11) → 飞 31F。
    #   终点实测：40F(10,11) HP3363 A163 D187 G2086 钥8/0/0。
    #   ⚠️ 本层战损 384→660（+276）是保真代价：战利品改为剧本末尾才铺，
    #      13 场全在 A151/D175 下打，騎士 165×3 不再被中途拿到的青晶递减。
    print()
    print('--- V68 40F（line300，双手剑士→红门→13波围杀→战利品→飞31F）---')
    #   V68 起点 40F(10,11) 直接打双手剑士(10,9)，省 fly32→祭坛→fly40 四步。
    #   起点 40F(10,11) 直接 goto(6,9)（西行 y11 顺路开 (9,11) 黄门），省 4 步。
    if not goto(w, 6, 9, '到(6,9)'): return 1
    if not goto(w, 6, 8, '过红门(6,8)决战区'): return 1
    #   踩 (6,7) 触发 66/126 剧本 —— 勇者原地不动，13 只怪依次走到 (6,6) 各出手一次
    #   （由内向外：死霊兵士×3 → 兵士×3 → 剣士×3 → 騎士×3 → 金騎士），
    #   第 18/19 段 金騎士 重现后沿 x6 退到 (6,1) 消失，(6,2) 立评分 NPC 并铺 12 件战利品。
    #   ⇒ 原「上门逐只打」的 12 格巡回全部作废，改为在门口接完 13 波再按同一批格子拾取。
    if not goto(w, 6, 7, '★踩(6,7)触发66/126剧本（13怪依次逼近）'): return 1
    if not run(w, [
        (6, 6, '到(6,6)'),
        (6, 5, '到(6,5)'),
        (6, 4, '到(6,4)'),
        (5, 4, '青药+800'),
        (4, 4, '青药+800'),
        (3, 4, '青药+800'),
        (3, 3, '到(3,3)'),
        (2, 3, '到(2,3)'),
        (2, 2, '赤晶 A+4'),
        (3, 2, '赤晶 A+4'),
        (4, 2, '赤晶 A+4'),
        (5, 2, '到(5,2)'),
        (6, 2, '评分NPC(6,2)'),
        (7, 2, '到(7,2)'),
        (8, 2, '青晶 D+4'),
        (9, 2, '青晶 D+4'),
        (10, 2, '青晶 D+4'),
        (10, 3, '到(10,3)'),
        (9, 3, '到(9,3)'),
        (9, 4, '黄钥+1'),
        (8, 4, '黄钥+1'),
        (7, 4, '黄钥+1'),
        (6, 4, '左一格(6,4)'),
        (6, 3, '北上(6,3)'),
        (6, 2, '北上(6,2)'),
    ], 'V68'): return 1
    #   原绕 (7,5)(6,5)…(10,11) 共 12 步才飞 39F；改为左一格到 (6,4)、北上 (6,3)(6,2)、
    #   踩 BOSS 死后现出的上行梯 (6,1)→41F(6,2)。V69 的 fly(39) 在 41F(6,2) 贴下行梯
