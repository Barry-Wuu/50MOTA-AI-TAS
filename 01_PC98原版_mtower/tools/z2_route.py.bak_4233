        (2, 6,  ''),
        (1, 6,  ''),
        (1, 5,  '門番Ｃ 无伤'),
        (2, 5,  ''),
        (3, 5,  '門番Ｃ 无伤'),
        (2, 5,  ''),
        (2, 4,  ''),
        (2, 3,  ''),
        (2, 2,  '★銀の剣 ATK+20'),
        (2, 3,  ''),
        (2, 4,  ''),
        (2, 5,  ''),
        (2, 6,  ''),
        (2, 7,  ''),
        (2, 8,  ''),
        (2, 9,  ''),
        (2, 10, ''),
        (2, 11, ''),
        (3, 11, ''),
        (4, 11, ''),
        (5, 11, ''),
    ], 'V6 取剑'): return 1
    if h.atk < 50:
        print('  !! V6 提前取剑未生效（ATK=%d，应为 50）' % h.atk); return 1
    #   15F 早在 V1-V5 首次到达过、可飞记录已更新）。17F(6,10) 已贴梯，直接飞 12F 省 1 步。
    if not fly(w, 12, 'V6 17F→12F 直飞（省 15F 中转）'): return 1

    print()
    print('=== 到达 12F（V6 完成）:', st(h))

    # ---------- V7: 12F 吃商店门口两个血瓶 → 左下过黄门打兽人拿钥匙 → 上16F ----------
    print('--- V7 12F（line213）---')
    # 商店门口血瓶：(5,10)(7,10) obj66 各+100。左下过黄门打兽人 (3,9) 拿钥匙 (1,7)(2,7)(1,8)(2,8)。
    if not run(w, [
        #   (7,10)(6,10) 只是绕上 y10 再下来 —— 删掉这两个路点，直接沿 y11 西行 (6,11)(5,11)。
        (3, 10, '黄门(3,10)'),
        (3, 9,  'ゾンビ'),            # (3,9) 兽人
        (2, 8,  '蓝钥'),              # (2,8) obj3 蓝钥匙
        (1, 8,  '黄钥'),
        (1, 7,  '黄钥'),
        (2, 7,  '黄钥'),
    ], 'V7'): return 1
    #   原「飞 15F → 沿 15F 绕一圈 → 踩 15F(6,1) 上 16F」只是为了回 16F 取 (5,5) 血瓶；
    #   血瓶已在 V6 顺手取掉，这里改「飞 17F(6,10) → 踩 (6,11) 下楼 → 16F(6,10)」，
    #   落点正是原 #1943，省掉整趟 15F 绕行。
    if not goto_stair_adj(w, 'V7 回梯旁'): return 1
    if not fly(w, 17, 'V7 12F→17F（飞行之珠，直落再下楼）'): return 1
    if not stair(w, 6, 11, 'V7 17F->16F（下楼）'): return 1

    print()
    print('=== 到达 16F（V7 完成）:', st(h))

    # ---------- V8: 16F 一访（line214）——绕开高级法师(2,2)(10,9)/兽人(5,3)(10,5)/兽人武士(6,6)/石头人(3,6)/史莱姆人(9,11) ----------
    # 关键点：只打 2 大蝙蝠(2,1)(2,3) + 2 大史莱姆(2,9)(9,2)，拿 6 黄钥+红蓝宝石+3 血瓶。
    print('--- V8 16F 一访（line214，绕开秒杀怪）---')
    #   且 (6,4) 蓝门 / (5,5) 血瓶 / (6,8) 黄门 都已在 V6「16F 穿行」办完 —— 前三个路点删掉，
    #   从 (2,9) 开始（落点 (6,10) 走 y10 下路即到）。
    if not run(w, [
        (2, 9, 'Ｂスライム'),         # obj45 -116
        #   (1,5)→(2,5)→(2,6)→(2,7)→(1,7)→(1,6)→(1,7)→(2,7) 的折返（4 步白走）。
        #   实际上从 (2,9) 进 (1,5) 的必经之路就是 (2,8)(2,7)(1,7)(1,6)(1,5) ——
        #   路上已顺路拾走 (2,7)黄钥 /(1,7)蓝晶 /(1,6)血瓶，之后只需 (2,5)→(2,8) 直接回头。
        (1, 5, '红晶 ATK+2'),         # obj80（顺路拾(2,7)黄钥/(1,7)蓝晶/(1,6)血瓶）
        (2, 5, '黄钥(2,5)'),
        (2, 8, '回(2,8)'),
        #   去 (4,2) 只能绕 (2,10)→(6,10)→x6 北上到 (6,2) 再西折，后 9 步纯过路。
        #   走到 (6,10)（贴 16F 下梯 (6,11)）用同层珠直接落 (6,2)。
        (6, 10, '到 16F(6,10) 梯旁（同层飞起跳）'),
    ], 'V8'): return 1
    if not fly(w, 16, 'V8 同层飞→16F(6,2)（省 x6 北上 9 步）'): return 1
    if not run(w, [
        (4, 2, '黄门(4,2)'),          # -1黄钥（回入口，进左上区）
        (2, 1, '大バット'),           # obj47 -138（绕高级法师(2,2)）
        (1, 1, '黄钥'),
        (1, 2, '黄钥'),
        (1, 3, '黄钥'),
        #   (2,3) 大バット 只是挡在 x1 列钥匙区西侧，主线从 (1,3) 直接
        #   (1,2)→(1,1)→(2,1)已清→(3,1)→(3,2)→(3,3) 即可回到 x3 竖道，完全不必碰它。
        #   省 -96。
        (1, 2, ''),
        (1, 1, ''),
        (2, 1, ''),
        (3, 1, ''),
        #   直接去掉（下一步 goto (8,2) 本来就从 (3,2) 往东）。
        (3, 2, ''),
        (8, 2, '黄门(8,2)'),          # -1黄钥（进右上区）
        (9, 2, 'Ｂスライム'),         # obj45 -116
        (11, 3, '血瓶+100'),          # obj66
        #   (6,10) 踩上梯 (6,11) 全是纯走位（黄钥已在 (7,3) 顺路拾取）。改为止于 (6,3)，
        #   向上贴下梯 (6,1) 的邻格 (6,2) 用飞行之珠直落 17F(6,10)。
        (6, 3, '黄钥(7,3)顺路'),       # 路上 (7,3) 拾黄钥 ky+1
    ], 'V8'): return 1
    if not goto_stair_adj(w, 'V8 贴 16F(6,1) 梯旁'): return 1
    #   （(8,11) 大バット、(11,11) 红药、回 (7,11) 飞 12F）整段删除。
    #   17F 首访改由 V18 完成，(8,11) 大バット / (11,11) 红药 由 V19 路过时采集。
    #   此处从 16F(6,2)（贴下梯 (6,1)）直接飞 12F(10,11)，等价原 V9 末尾的飞 12F。
    if not fly(w, 12, 'V8 16F→12F（飞行之珠，省 17F 右区绕行）'): return 1

    print()
    print('=== 到达 12F（V8 完成，V9 已并入）:', st(h))

    # ---------- V9: 17F（line215）——银剑已在 V6 提前取走，此处只剩右区 + 提前 16F 绕圈 ----------
    print('--- V9 17F（line215，取剑已提前至 V6）---')
    if h.atk < 52:
        print('  !! V9 银剑未生效（ATK=%d，应为 52）' % h.atk); return 1
    #   原路线把 16F 绕圈（大蝙蝠(2,1)(2,3)-192、Ｂスライム(9,2)-32、3 把黄钥、2 红晶、1 青晶）
    #   排在 **V21**，那时 ATK 仍是 32；而银剑 ATK+20 要到 V9 才拿。
