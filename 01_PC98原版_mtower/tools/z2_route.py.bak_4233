# -*- coding: utf-8 -*-
"""z2_route.py —— 按攻略 line207-239 逐访翻译 2 区（11F-20F）为显式路径点。

职责：goto 只做层内导航（打怪/开门/拾取自动处理），
      但【拾取格 / 关键战斗 / 关键门】按攻略显式列为路径点，防止最短路漏拾。
      祭坛用 altar(ax,ay) 指定策略次数。

用法：python tools/z2_route.py
"""
import sys, os
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import mota_core as M

DIRS = ((1, 0), (-1, 0), (0, 1), (0, -1))
REC = []

def st(h):
    return 'HP%-5d A%-3d D%-3d G%-5d 钥%d/%d/%d %dF(%2d,%2d)' % (
        h.hp, h.atk, h.dfn, h.gold, h.keys['y'], h.keys['b'], h.keys['r'], h.f, h.x, h.y)

def need(w, y=0, b=0, r=0, g=0, label=''):
    """钥匙/金币下限核对：攻略本段所需量 vs 实有量。"""
    h = w.hero
    ok = (h.keys['y'] >= y and h.keys['b'] >= b
          and h.keys['r'] >= r and h.gold >= g)
    print('  [需求核对] %-22s 需 黄%d/蓝%d/红%d 金%-4d | 实有 黄%d/蓝%d/红%d 金%-4d %s' % (
        label, y, b, r, g, h.keys['y'], h.keys['b'], h.keys['r'], h.gold,
        'OK' if ok else '!! 不足'))
    return ok

def _stair_cells(w, f):
    s = set()
    for c in M.STAIRS.get(f, (None, None)):
        if c:
            s.add(c)
    if f == 10 and getattr(w, 'boss10', False):
        s.add((6, 11))
    if f == 20 and getattr(w, 'boss20', False):
        s.add((6, 1))
    if f == 30 and getattr(w, 'slime30', False):
        s.add((6, 1))
    if f == 40 and getattr(w, 'boss40', False):
        s.add((6, 1))                      # ✅ 40F BOSS 死后 (6,1) 现上行梯（V68 绕行避免误踩）
    return s

def _cost(w, f, nx, ny):
    """(可否通过, 代价)。拾取格强烈偏好（0.05），怪物 100、门 25、空 1。"""
    if not (1 <= nx <= 11 and 1 <= ny <= 11):
        return False, 0
    #    代价 50 介于门 25 与怪 100 之间：绕行优先于穿人、但打怪路径仍可选）。
    if (f, nx, ny) in _AVOID_NPC_CELLS:
        return True, 50
    if w.terrain_at(f, nx, ny) in (1, 2):
        trig = M.DIG_WALLS.get((f, nx, ny))
        if trig is not None and trig in w.cleared:
            return True, 1
        if (f, nx, ny) in M.DARKWALL_CELLS:
            return True, 3
        if w.at(f, nx, ny) == 89:
            return True, 3
        return False, 0
    if (nx, ny) in _stair_cells(w, f):
        return False, 0
    #   引擎 move() 有 DRAGON_BODY 硬拦，但这里若按 NORMAL 放行（代价 0.05），
    #   A* 会选 x5 列直上而不是绕左侧暗道 → 走到 (5,8) 撞墙。
    if f == M.DRAGON_F and (nx, ny) in M.DRAGON_BODY and not getattr(w, 'dragon35_dead', False):
        return False, 0
    o = w.at(f, nx, ny)
    if not o:
        return True, 1
    if o in M.ALTAR_SIDE:                       # 祭坛左右侧格 obj21/23：不可踩（move() 同样拦截）
        return False, 0
    ty = M.TYPE.get(M.oatr(o, 3))
    if o == 89:
        return True, 3
    if o == 115:
        # ⚠️ 23F 的 obj115 隐形砖是实体墙（"Go 0F" 字样），必须绕行，不可穿过。
        #    其它楼层遇 obj115 保持可走（cost 3，如 33F 等）。
        if f == 23:
            return False, 0
        return True, 3
    if o == 20 and (f, nx, ny) in M.PIT_GUARD_CLEAR:
        #   规划器必须与引擎一致：守卫未清时此格不可通行，否则会规划出穿穴路径 → 引擎撞墙 → 白走步数。
        _gd = M.PIT_GUARD_CLEAR[(f, nx, ny)]
        if not all((f, gx, gy) in w.cleared for gx, gy in _gd):
            return False, 0
    if o in M.KEY_OF or ty in ('STATUS', 'ITEM', 'NORMAL', 'SCORE', 'MESSAGE'):
        return True, 0.05
    if ty == 'DOOR':
        col = M.DOOR_OF.get(o)
        return (col is not None and w.hero.keys[col] > 0), 25
    if ty == 'SELL':
        return (w.hero.gold >= M.SHOP_PRICE.get(o, 0)), 3
    if ty == 'SAIDAN':
        return (f, nx, ny) in M.ALTAR_CELLS, 5
    if ty == 'MONSTER':
        r = w.battle(o)
        return (r is not None and r[0] < w.hero.hp), 100
    return False, 0

def _step(w, d):
    broke = ('blocked', '打不动', '打不过', '无', '不可通行', '买不起', '祭坛金币不足')
    b = (w.hero.f, w.hero.x, w.hero.y)
    lg = w.move(*d)
    if lg and any(t in lg[0] for t in broke):
        return False, lg
    if (w.hero.f, w.hero.x, w.hero.y) == b and lg:
        lg2 = w.move(*d)
        if lg2 and any(t in lg2[0] for t in broke):
            return False, lg2
        lg = lg + lg2
    return True, lg

#    原贴梯 Dijkstra 直穿 (4,3) 老登（MESSAGE 代价 0.05 强烈偏好），
#    改从 x5 列北上 (5,1) 西行接 (2,1)——绕开不交谈，步数持平。
_AVOID_NPC_CELLS = {(33, 4, 3)}

def sell_keys(w, n, label=''):
    """✅ 2026-11-20（用户：28F 卖 3 把钥匙凑买镐钱）：撞 obj161 收购商卖钥匙。
    英雄站商人邻格、朝商人方向撞 1 次 = 卖 1 把黄钥 +100G（引擎 SELL 实现，英雄不移动）。
    ⚠️ 不走 _step：卖钥步不移动但成功，_step 会误判「未走成」再补撞一次 → 一次卖 2 把。"""
    h = w.hero
    for d in ((0, -1), (0, 1), (-1, 0), (1, 0)):
        if w.at(h.f, h.x + d[0], h.y + d[1]) == 161:
            lg = w.move(*d)
            if lg and ('无黄钥匙' in lg[0] or 'blocked' in lg[0]):
                print('  !! 卖钥匙失败 %s: %s' % (label, lg)); return False
            if not lg or '卖黄钥' not in lg[0]:
                print('  !! %s：异常返回 %s' % (label, lg)); return False
            print('  %-22s %s' % (label, st(h)))
            return True
    print('  !! %s：四邻未找到 obj161 商人' % label)
    return False

def goto(w, tx, ty, label=''):
    import heapq
    h = w.hero
    start = (h.x, h.y)
    if start == (tx, ty):
        return True
    dist = {start: 0}
    prev = {start: None}
    pq = [(0, start)]
    found = False
    while pq:
        dcur, c = heapq.heappop(pq)
        if c == (tx, ty):
            found = True
            break
        if dcur > dist.get(c, 1e9):
            continue
        for dd in DIRS:
            n = (c[0] + dd[0], c[1] + dd[1])
            ok, wc = _cost(w, h.f, *n)
            if not ok:
                continue
            nd = dcur + wc
            if nd < dist.get(n, 1e9):
                dist[n] = nd
                prev[n] = c
                heapq.heappush(pq, (nd, n))
    if not found:
        print('  !! 不可达 (%d,%d) from %s' % (tx, ty, start))
        return False
    seq = []
    cur = (tx, ty)
    while cur != start:
        seq.append(cur)
        cur = prev[cur]
    seq.reverse()
    for (nx, ny) in seq:
        dx, dy = nx - w.hero.x, ny - w.hero.y
        f0 = w.hero.f
        o0 = w.at(f0, nx, ny)
        ok, lg = _step(w, (dx, dy))
        if not ok:
            print('  !! 卡在 %s: %s' % (st(w.hero), lg))
            return False
        if os.environ.get('Z2_PATH') == '1' and o0:
            print('       [path] %dF(%2d,%2d) obj%-4d %-8s -> %s' % (
                f0, nx, ny, o0, M.TYPE.get(M.oatr(o0, 3)), st(w.hero)))
        if w.hero.f != f0:
            print('  !! 层内路径误踩楼梯 %dF(%d,%d)：%s' % (f0, nx, ny, lg))
            return False
    print('  %-26s %s' % (label or '(%d,%d)' % (tx, ty), st(w.hero)))
    return True

def stair(w, sx, sy, label=''):
    h = w.hero
    #   原按固定顺序 (下,上,右,左) 取第一个可站邻格 → 总是走到梯下方 (sx,sy+1)，
    #   即使英雄已站在梯另一侧邻格（如 (5,1) 贴梯 (6,1)），仍绕 2 步到 (6,2) 再踩。
    #   改为按 Dijkstra 距离取最近邻格（与 run_segs.py 的 stair 口径一致），
    #   英雄已贴梯时 distance=0 → 原地踩，省去绕行 2 步。
    cands = []
    for d in ((0, 1), (0, -1), (1, 0), (-1, 0)):
        ax, ay = sx + d[0], sy + d[1]
        if not (1 <= ax <= 11 and 1 <= ay <= 11):
            continue
        if not _cost(w, h.f, ax, ay)[0]:
            continue
        cands.append((ax, ay))
    cands.sort(key=lambda p: _dist_to(w, p[0], p[1]) if _dist_to(w, p[0], p[1]) is not None else 1e9)
    for (ax, ay) in cands:
        if not goto(w, ax, ay):
            continue
        ok, lg = _step(w, (sx - w.hero.x, sy - w.hero.y))
        if not ok:
            print('  !! 上楼梯失败: %s' % lg)
            return False
        print('  %-26s %s' % (label, st(w.hero)))
        return True
    print('  !! 楼梯 %dF(%d,%d) 无可达入口' % (h.f, sx, sy))
    return False

def run(w, pts, tag=''):
    """pts: (x,y,label) 列表，('stair',x,y,label)，或 ('dirs','方向串',label)。"""
    for p in pts:
        if p[0] == 'stair':
            if not stair(w, p[1], p[2], p[3]):
                return False
        elif p[0] == 'dirs':
            for _ch in p[1]:
                ok, _lg = _step(w, {'>': (1, 0), '<': (-1, 0), '^': (0, -1), 'v': (0, 1)}[_ch])
                if not ok:
                    print('  !! %s 方向串 %s 受阻 (%d,%d): %s' % (tag, p[1], w.hero.x, w.hero.y, _lg))
                    return False
            print('  %-26s %s' % (p[2] or p[1], st(w.hero)))
        else:
            if not goto(w, p[0], p[1], '%s %s' % (tag, p[2])):
                return False
    return True

def fly(w, target_f, label=''):
    """飞行之珠 obj26：英雄须站在当前层楼梯旁，传送到 target_f（落点 FLY_LAND）。"""
    h = w.hero
    lg = w.fly(target_f)
    # 失败消息形如「飞行之珠：尚未持有…」「飞行之珠：须站在…」（带全角冒号）；
    # 成功消息是「飞行之珠传送 → …」（无冒号）。用「飞行之珠：」或「无法」判定失败。
    if lg and ('飞行之珠：' in lg[0] or '无法' in lg[0]):
        print('  !! 飞行失败 %dF→%dF: %s' % (h.f, target_f, lg))
        return False
    print('  %-22s %s' % (label, st(w.hero)))
    return True

def _dist_to(w, tx, ty):
    """到 (tx,ty) 的 Dijkstra 距离（与 goto 同权重；不可达返回 None）。只读，不改状态。"""
    import heapq
    h = w.hero
    start = (h.x, h.y)
    if start == (tx, ty):
        return 0
    dist = {start: 0}
    pq = [(0, start)]
    while pq:
        dcur, c = heapq.heappop(pq)
        if c == (tx, ty):
            return dcur
        if dcur > dist.get(c, 1e9):
            continue
        for dd in DIRS:
            n = (c[0] + dd[0], c[1] + dd[1])
            ok, wc = _cost(w, h.f, *n)
            if not ok:
                continue
            nd = dcur + wc
            if nd < dist.get(n, 1e9):
                dist[n] = nd
                heapq.heappush(pq, (nd, n))
    return None

def goto_stair_adj(w, label=''):
    """把英雄移到**最近**的楼梯邻格（飞行之珠/升降须站梯旁）。
    ⚠️ 2026-11-14：原实现按 STAIRS 顺序取「第一个可站邻格」——如 43F 的 STAIRS=((1,11),(1,1))
       恒取 (1,10)，哪怕另一侧梯旁 (1,2) 近 8 步也照走不误（43F 两处各白走 8 步）。
       现改为按 Dijkstra 距离取最近的梯旁格（代价与 goto 同一套 _cost 权重）。"""
    h = w.hero
    s = M.STAIRS.get(h.f)
    if not s:
        return False
    cands = []
    for (sx, sy) in [c for c in s if c]:
        for d in ((0, 1), (0, -1), (1, 0), (-1, 0)):
            ax, ay = sx + d[0], sy + d[1]
            if not (1 <= ax <= 11 and 1 <= ay <= 11):
                continue
            if not _cost(w, h.f, ax, ay)[0]:
                continue
            cands.append((ax, ay))
    best = None
    for (ax, ay) in cands:
        d = _dist_to(w, ax, ay)
        if d is None:
            continue
        if best is None or d < best[0]:
            best = (d, ax, ay)
    if best is None:
        return False
    return goto(w, best[1], best[2], '%s 到梯旁(%d,%d)' % (label, best[1], best[2]))

def altar_uses(w, ax, ay, n, policy, label=''):
    """祭坛献祭 n 次（策略 atk/dfn）。
    ✅ 2026-11-13 Java 真值修正：面朝祭坛触发（MTower.java L6404 directCheck 面前格、
    L5804 type==7 弹菜单），人物**不移动** → 走到邻格后原地连献，每次 0 步。
    旧「走进祭坛格再退一步」建模作废（每次多 2 步）。"""
    w.altar_policy = policy
    # 祭坛本体邻格：优先找真正空地(obj==0)邻格，再退而求其次找可站立邻格
    h = w.hero
    nbr = None
    for d in DIRS:
        nx, ny = ax + d[0], ay + d[1]
        if 1 <= nx <= 11 and 1 <= ny <= 11 and (nx, ny) != (ax, ay):
            if w.at(h.f, nx, ny) == 0 and _cost(w, h.f, nx, ny)[0]:
                nbr = (nx, ny)
                break
    if nbr is None:
        for d in DIRS:
            nx, ny = ax + d[0], ay + d[1]
            if 1 <= nx <= 11 and 1 <= ny <= 11 and (nx, ny) != (ax, ay):
                if _cost(w, h.f, nx, ny)[0]:
                    nbr = (nx, ny)
                    break
    if nbr is None:
        print('  !! 祭坛 %dF(%d,%d) 无邻格' % (h.f, ax, ay))
        return False
    if not goto(w, nbr[0], nbr[1], '%s 祭坛邻格' % label):
        return False
    for i in range(n):
        lg = w.face_altar(ax, ay)
        txt = ';'.join(lg)
        if '不足' in txt or '错误' in txt or '必须' in txt:
            print('  !! %s 祭坛#%d: %s' % (label, i + 1, txt))
            return False
        _trace(w, None, (0, 0), lg, 'altar') if '_trace' in globals() else None
        REC.append((h.f, h.x, h.y, h.hp, h.atk, h.dfn, h.gold,
                    h.keys['y'], h.keys['b'], h.keys['r'], txt[:80], '0,0')) if 'REC' in globals() else None
        print('  %s 祭坛#%d(面朝): %s' % (label, i + 1, txt))
    return True

def _hp_scan(w, floors=(41, 42, 43, 45, 46, 47)):
    """调试：从各层飞行落点 BFS，列出当前钥匙/战力下可达的 HP/属性道具及门代价。"""
    import heapq
    print('\n=== HP/属性来源可达性扫描（当前 %s）===' % st(w.hero))
    for f in floors:
        start = M.FLY_LAND.get(f)
        if not start:
            continue
        dist = {start: 0}
        pq = [(0, start)]
        while pq:
            d0, c = heapq.heappop(pq)
            if d0 > dist.get(c, 1e9):
                continue
            for dd in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                n = (c[0] + dd[0], c[1] + dd[1])
                if not (0 <= n[0] <= 12 and 0 <= n[1] <= 12):
                    continue
                ok, wc = _cost(w, f, n[0], n[1])
                if not ok:
                    continue
                nd = d0 + wc
                if nd < dist.get(n, 1e9):
                    dist[n] = nd
                    heapq.heappush(pq, (nd, n))
        rows = []
        for (x, y), d0 in dist.items():
            o = w.at(f, x, y)
            if not o:
                continue
            hp, atk, dfn = M.oatr(o, 10), M.oatr(o, 11), M.oatr(o, 12)
            if hp or atk or dfn:
                rows.append((d0, x, y, o, hp, atk, dfn))
        rows.sort()
        print('  %2dF 起点%s 可达 %d 格，属性道具 %d 个' % (f, start, len(dist), len(rows)))
        for (d0, x, y, o, hp, atk, dfn) in rows:
            print('     (%2d,%2d) obj%-4d %-24s HP%+5d ATK%+3d DEF%+3d cost=%.1f'
                  % (x, y, o, M.oname(o)[:22], hp, atk, dfn, d0))

def _dump_floor(w, f):
    """调试：打印某层活状态（V-seg 规划用）。设环境变量 MOTA_PROBE_FLOOR=14 即在
    main() 末尾（当前路线终点）转储该层：字符地图 + 物件清单（含名字/属性）。"""
    h = w.hero
    print()
    print('=== 活层探查 %dF（终点 %s）===' % (f, st(h)))
    ups, dns = set(), set()
    for (sf, sx, sy), dst in M.WARP.items():
        if sf == f and dst:
            (ups if dst[0] > f else dns).add((sx, sy))
    for y in range(13):
        row = []
        for x in range(13):
            ch = '#'
            if w.terrain_at(f, x, y) != 1:
                ch = '^' if (x, y) in ups else ('v' if (x, y) in dns else '.')
            if (f, x, y) in M.DARKWALL_CELLS and (f, x, y) not in w.cleared:
                ch = 'D'
            o = w.at(f, x, y)
            if o:
                if o in M.KEY_OF:
                    ch = {'y': 'y', 'b': 'b', 'r': 'r'}[M.KEY_OF[o]]
                elif o in M.DOOR_OF:
                    ch = {'y': 'Y', 'b': 'B', 'r': 'R'}[M.DOOR_OF[o]]
                elif o == 89:
                    ch = 'D'
                elif o in M.SHOP:
                    ch = '$'
                else:
                    ty = M.TYPE.get(M.oatr(o, 3), '?')
                    ch = {'MONSTER': 'm', 'ITEM': '!', 'STATUS': '+', 'MESSAGE': '?'}.get(ty, '?')
            if h.f == f and (x, y) == (h.x, h.y):
                ch = '@'
            row.append(ch)
        print('%2d %s' % (y, ' '.join(row)))
    print('   ' + ' '.join('%X' % x for x in range(13)))
    n = 0
    for y in range(13):
        for x in range(13):
            o = w.at(f, x, y)
            if not o:
                continue
            n += 1
            ty = M.TYPE.get(M.oatr(o, 3), '?')
            c10, c11, c12, c13 = (M.oatr(o, c) for c in (10, 11, 12, 13))
            if (f, x, y) in M.DARKWALL_CELLS and (f, x, y) not in w.cleared:
                tag = '暗墙格（撞塌露出底下物件）'
            elif o in M.KEY_OF:
                tag = {'y': '黄钥', 'b': '蓝钥', 'r': '红钥'}[M.KEY_OF[o]]
            elif o in M.DOOR_OF:
                tag = {'y': '黄门', 'b': '蓝门', 'r': '红门'}[M.DOOR_OF[o]]
            elif o in M.SHOP:
                tag = '商店'
            elif ty == 'MONSTER':
                tag = 'HP%d ATK%d DEF%d 金%d' % (c10, c11, c12, c13)
            elif ty in ('ITEM', 'STATUS'):
                tag = 'HP%s ATK%s DEF%s 价%s' % tuple(
                    ('%d' % v if v else '-') for v in (c10, c11, c12, c13))
            else:
                tag = ''
            print('  (%2d,%2d) obj%-3d %-8s %-16s %s' % (x, y, o, ty, M.oname(o), tag))
    print('--- 共 %d 格有物件；物品: %s；钥 %d/%d/%d ---' % (
        n, sorted(h.items) if h.items else '无', h.keys['y'], h.keys['b'], h.keys['r']))

def main():
    # 2 区必须接在真实 1 区终态上：门开关、怪死活、10F BOSS 上行梯、祭坛累计次数
    # 全在 World 状态里；脱离 1 区另开新世界会让回头路（8F→11F 经 10F）失真。
    os.environ['MOTA_STOP_11F'] = '1'
    import run_segs
    if run_segs.main() != 0:
        print('!! 1 区重放失败，2 区无法开始')
        return 1
    w = run_segs.LAST_W
    h = w.hero
    print()
    print('=== 起点（1 区真实终态，11F）:', st(h))
    print()

    # ---------- V1: 11F 直接向右，打蝙蝠上楼 ----------
    print('--- V1 11F（line207）---')
    if not run(w, [
        (10, 9, 'バット'),          # (10,9) obj7 蝙蝠
    ], 'V1'): return 1
    if not stair(w, 11, 11, 'V1 11F->12F'): return 1

    # ---------- V2: 12F 向左打蝙蝠 → 祭坛（攻略 line208：升 2 次防 1 次攻）→ 打蝙蝠上楼 ----------
    print('--- V2 12F（line208，2 防 1 攻）---')
    if not run(w, [
        (8, 11, 'バット'),          # (8,11) 蝙蝠
    ], 'V2'): return 1
    if not altar_uses(w, 6, 9, 2, 'dfn', 'V2'): return 1
    # ⚠️ 第 3 次（攻）需 140G，此处只有 133G → 攻略 line208 的「2防1攻」拆到 V10 补攻（line216「升级攻击」）。
    if not run(w, [
        (4, 11, 'バット'),          # (4,11) 蝙蝠 上楼前
    ], 'V2'): return 1
    if not stair(w, 1, 11, 'V2 12F->13F'): return 1

    # ---------- V3: 13F 直接上楼 ----------
    print('--- V3 13F（line209）---')
    if not run(w, [
    ], 'V3'): return 1
    if not stair(w, 11, 11, 'V3 13F->14F'): return 1

    # ---------- V4: 14F 过黄门打大史莱姆 → 下中黄门 → 暗道 → 血瓶 → 回11F ----------
    print('--- V4 14F（line210）---')
    if not run(w, [
        (9, 9,  '黄门(9,9)'),
        (8, 8,  'Ｂスライム'),       # (8,8) 大史莱姆
        (6, 8,  '黄门(6,8)'),
        (6, 9,  '暗道(6,9) 撞塌'),
        (5, 10, '血瓶+100'),          # (5,10) obj66
    ], 'V4'): return 1
    # 回 11F：14F(11,11)->13F(1,11)->12F(11,11)->11F
