    if not fly(w, 20, 'V69 20F 取左袋'): return 1
    if not run(w, [
        (5, 10, 'y10 西行'), (5, 11, '下 y11'),
        (4, 11, '到(4,11)'), (3, 11, '到(3,11)'),
        #   顺路补回 V45 砍掉的专程杀石头人（A163 D187 秒杀不掉血）。
        (2, 11, '到(2,11)'), (2, 10, '↑ロック obj56 +28G'),
        (1, 10, '←到(1,10)'), (1, 9, '到(1,9)（黄门 V26 已开）'), (1, 8, '到(1,8)'),
        (1, 7, '到(1,7)（バット V26 已清）'),
        (2, 7, '到(2,7)'),
        (2, 6, '蓝门(2,6) -1蓝'),
        (2, 5, '到(2,5)'),
        (2, 4, '赤晶(2,4) +2ATK'),
        (1, 4, '青晶(1,4) +2DEF'),
        (1, 5, '★黄钥(1,5) +1黄'),
        #   (1,6) 是墙不可走，但 (1,5) 右邻 (2,5) 空地 → 直接 (1,5)(2,5)(2,6)(2,7)(1,7)
        #   只需5步（(2,6)蓝门已开），省掉 (1,4)(2,4) 两步折返。
        (2, 5, '回(2,5) 右绕（免(1,4)(2,4)折返）'), (2, 6, '回(2,6)'), (2, 7, '回(2,7)'),
        (1, 7, '回(1,7)'), (1, 8, '回(1,8)'), (1, 9, '回(1,9)'), (1, 10, '回(1,10)'),
        (1, 11, '回(1,11)'), (2, 11, '回(2,11)'), (3, 11, '回(3,11)'), (4, 11, '回(4,11)'),
        (5, 11, '回(5,11) 贴上行梯(6,11)，就地飞 40F（省原(5,10)(6,10)两步）'),
    ], 'V69'): return 1
    #   （(11,3)(10,3)(10,4)(10,5)(11,5)战士(11,6)(11,7)(10,7)(10,8)(10,9)(10,10)）
    #   才到 (10,10)。改为直飞 40F（落点 (10,11)＝下行梯 (11,11) 踏出格），一步踩下行梯
    #   下到 39F(10,11)，再 ⬆️ 一格即 (10,10)，省 12 步绕路 + 免打 (11,5) 战士（-22HP+45G）。
    #   40F 已首访（BOSS 段）可珠飞；39F(10,11) 是地板。
