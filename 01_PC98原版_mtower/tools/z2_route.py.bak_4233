        (2, 6, ''), (2, 7, ''), (2, 8, ''), (2, 9, ''), (2, 10, ''),
        (3, 10, ''), (4, 10, ''), (5, 10, ''), (6, 10, '回中轴(6,10)，贴上行梯(6,11)'),
