    print()
    print('--- V71 41F（line322，中心飞行器(6,2)→(6,10) 避开(6,4)夹击）---')
    # 落点规则（Java MTower.java @1191-1202 实证）：charaX=(12-charaX/5)*5
    #   → 格坐标 (x,y) 的中心对称点 = (12-x, 12-y)，以 (6,6) 为旋转中心。
    #   (6,2) → (12-6, 12-2) = (6,10) ✓ 邻上行梯 (6,11)
    lg = w.wing_center()
    if not lg or '中心飞行器' not in lg[0]:
        print('  !! 中心飞行器失败:', lg)
        return 1
    if (h.x, h.y) != (6, 10):
        print('  !! V71 中心飞行器落点异常，应为 (6,10)，实到 %s' % st(h)); return 1
    print('  %-26s %s' % ('V71 中心飞行器(6,2)→(6,10)', st(h)))
    if not stair(w, 6, 11, 'V71 41F(6,11)→42F'): return 1
    print('=== 到达 42F（V71 完成）:', st(h))

    # ---------- V72: line323 42F——剧情毕→(攻略 20F 拿血瓶已提前完成)→右中过黄门拿钥匙→同层飞行→上 43F ----------
    # 攻略 line323：剧情骑士队长被杀 → 下 20F 右下打高级法师（不伤）拿血瓶（L≈207）→ 上 42F；
    #   右中过黄门被 2 初级巫师 + 2 魔法警卫扣血 → 拿钥匙 → 同层飞行到楼梯口 → 上 43F。
    # ① 42F 剧情已进层触发（V71 踩梯时 apply_floor_events(42)：金騎士+四角魔導師伏兵清场，story42=True）。
    # ② 20F 支线整段跳过（目标已全部入账，与 V69 替换 15F 蓝钥同类处理）：
