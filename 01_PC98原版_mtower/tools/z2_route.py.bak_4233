    #   玩家须：x11 竖列 → (11,7) → 杀 (10,7) 魔術師 → (9,7)(8,7)(7,7)，
    #   **站 (7,7) 用普通镐 obj114 破四邻（关键 (7,8)）**，打通进下部拿剑。
    #   ⚠️ 攻略 line329 48F 只做「用镐拿圣剑」，拿剑即返，不碰右区 4 魔導師。
    print()
    print('--- V79 48F（line329，站(7,7)用镐破(7,8)拿圣剑→即返47F）---')
    if not run(w, [
        (11, 10, '落点(11,10)'),
        (11, 9, 'x11 竖列上行'),
        (11, 8, '到(11,8)'),
        (11, 7, '到(11,7)'),
        (10, 7, '杀魔術師(10,7)进上部'),
        (9, 7, '到(9,7)'),
        (8, 7, '到(8,7)'),
        (7, 7, '★站(7,7)准备用镐破(7,8)'),
    ], 'V79'): return 1
    ok, lg = w.use_pick()
    for _l in lg:
        print('      · %s' % _l)
    print('  %-26s %s' % ('V79 用镐破(7,8)', st(h)))
    if not ok: return 1
    if not run(w, [
        (7, 8, '过破口(7,8)'),
        (7, 9, '进圣剑库下部'),
        (8, 9, '到(8,9)'),
        #   回程原路绕 (9,10)(9,9)，共 4 步纯多余。(8,9)↔(8,10) 直上直下即可取剑，
        #   剑仍在 (8,10) 拾取，ATK+50 不变。
        (8, 10, '★圣剑 obj33 ATK+50（直取）'),
        (8, 9, '回(8,9)'),
        (7, 9, '回(7,9)'),
        (7, 8, '回(7,8)'),
        (7, 7, '回(7,7)'),
        (8, 7, '回(8,7)'),
        (9, 7, '回(9,7)'),
        (10, 7, '回(10,7)'),
        (11, 7, '回(11,7)'),
        (11, 8, '到(11,8)'),
        (11, 9, '到(11,9)'),
    ], 'V79'): return 1
    if not stair(w, 11, 11, 'V79 48F(11,11)下行梯→47F'): return 1
    print('=== 到达 %dF（V79 完成）:' % h.f, st(h))

    # 调试开关：V80 规划期，跑完 V79 即停并转储 47F/46F 活网格
    if os.environ.get('MOTA_STOP_AFTER_V79'):
        print('   V79 结束位置确认: %s' % st(h))
        pf = os.environ.get('MOTA_PROBE_FLOOR')
        if pf:
            for _pf in pf.split(','):
                _dump_floor(w, int(_pf))
        return 0

    # ------------------------------------------------------------------
    # V80：47F 取蓝钥/赤青晶（(2,6)黄门 → x3 竖列 → (4,8)蓝门 南入口）
    #      零战斗：不碰 (3,5)吸血、(5,4)魔術師Ａ、(6,5)魔術師Ｂ
    #      黄钥 1-1+1 持平，蓝钥 1-1+1 持平，HP 无损耗
    #      （原写法走北口要连开 (2,6)+(4,4) 两扇黄门，到 47F 只有 1 黄钥 → 死锁）
    # ------------------------------------------------------------------
    print()
    print('--- V80 47F 南入口取蓝钥 + 赤/青晶（零战斗）---')
    if not run(w, [
        (2, 6, '黄门(2,6) -1黄'),
        (3, 6, '到(3,6)'),
        (3, 7, '到(3,7)'),
        (3, 8, '到(3,8)'),
        (4, 8, '蓝门(4,8) -1蓝'),
        (5, 8, '赤晶(5,8) +5ATK'),
        (6, 8, '青晶(6,8) +5DEF'),
        (6, 7, '黄钥(6,7) +1黄'),
        (5, 7, '蓝钥(5,7) +1蓝'),
    ], 'V80'): return 1
    print('   V80 完成: %s' % st(h))

    # ---------- V81: （原「39F 买蓝钥 obj166」）——已前移到 V69 ----------
    #   现由 V69 在 39F 段尾买入（同一家店、同一价格，总支出不变），
    #   目的是先造出蓝钥余量，好把 20F 左袋提前到 V69 完成。
    #   故本段只剩「走到 47F(2,1) 楼梯旁」一个动作，供 V82 飞 38F。
    print('--- V81 （买蓝钥已前移 V69）47F y1 走廊东段补钥匙 ---')
    if not goto(w, 3, 6, 'V81 到(3,6) 插^v前'): return 1
    for _ch in '^v':
        if not _step(w, {'^': (0, -1), 'v': (0, 1)}[_ch])[0]:
            print('  !! V81 47F 方向串 ^v 受阻 (%d,%d)' % (h.x, h.y)); return 1
    if not goto(w, 2, 1, 'V81 到 47F(2,1) 楼梯旁'): return 1
    #   y1 走廊：(2,1) →(3,1)蓝门 -1蓝 →(4,1..6,1)→(7,1)黄门 -1黄 →(8,1..11,1)黄钥 +1
    #           →(11,2)青晶 D+5 →(11,3)黄钥 +1。净 黄 +1 / 蓝 -1 / D+5。
    if not need(w, y=1, b=1, label='V81 47F y1 走廊 (3,1)蓝门+(7,1)黄门'): return 1
    if not run(w, [
        (3, 1, '蓝门(3,1) -1蓝'),
        (4, 1, ''), (5, 1, ''), (6, 1, ''),
        (7, 1, '黄门(7,1) -1黄'),
        (8, 1, ''),
        # 4175vv>4183：(8,1)→(8,2)杀魔術師Ａ→(8,3)→(9,3)史莱姆，接(10,3)北上；
        # 黄钥(11,1)/青晶(11,2)/黄钥(11,3) 经(11,3)北上顺路拾。
        ('dirs', 'vv>', '4175vv>4183'),
        (10, 3, ''), (11, 3, '★黄钥(11,3) +1黄'),
        (11, 2, '★青晶(11,2) +5DEF'), (11, 1, '★黄钥(11,1) +1黄'),
        (10, 1, ''), (9, 1, ''), (8, 1, ''),
        (7, 1, ''), (6, 1, ''), (5, 1, ''), (4, 1, ''), (3, 1, ''), (2, 1, ''),
    ], 'V81'): return 1
    print('  %-26s %s' % ('V81 就位', st(h)))

    # ---------- V82: 38F 买黄钥 + 41F 暗墙拿降臨翼 + 0F 幸运金币 ----------
    # 用户定：先 0F 后 44F。降臨翼必须触发 41F 暗墙事件（杀(2,2)+撞(10,2)+杀魔術師A）。
    # ⚠️ 41F **北入口** (6,2) 必踩 (6,4) 魔導師夹击（HP减半 2497→1249），随后战损 1912 → 必崩。
    #    改走 **南入口**：47F→fly(42F)→42F(6,11)下行梯→41F(6,10)，从南向北进，完全避开
    #    (6,4) 夹击，也不用杀两只魔導師——(5,4)(7,4) 是仅由 (6,4) 可达的死角，不碰。
    #    41F 战损（南入口）= 魔術師B(3,5)(9,5)各(164战+100邻) + 魔術師A(2,2)(348战+200邻)
    #    + 魔術師A(10,2 刷出)348 = 1424 → HP2497-1424=1073 足够。
    #    钥匙：5 黄门(6,7)(6,8)(6,9)(3,4)(9,4) + 2 蓝门(5,6)(7,6)。当前 钥3/4/0 → 38F 买 3 黄。
    #    （V81 已买 3 蓝钥；旧 ① 39F(9,11)+200HP 是 no-op——已被 V63/V69 拿过，故删除。）
    print()
    print('--- V82 38F买黄钥 → 41F暗墙拿降臨翼 → 0F幸运金币 ---')
    #   本段从 V81 留下的 47F(2,1) 出发，直接飞 42F 进 41F 事件。
    #   本段不再专程 fly(20) 往返，只用 38F 买的 3 黄钥。
    # ③ 41F 暗墙事件（南入口）：42F 下行梯进 41F(6,10) → 杀(2,2) + 撞(10,2) + 杀刷出魔術師A
    #      (5,6)(6,6)(7,6)  地板·蓝门 → **墙**   （y6 整排封死，中心口袋被横向切断）
    #      (5,7)(7,7)      墙       → **地板**   （渲染图上那 2 格深色墙砖就是它们）
    #      (6,5)                    → 生成 降臨の翼 obj108
    #    ⇒ 事件后 (10,2) 外区 与 (6,5) 翼**不连通**（翼被封死在中心口袋）。
    #      取翼必须走**北入口**：先到 41F(6,1) 下行梯 → 40F(5,1) → 40F(6,1) 上行梯(BOSS死后)
    #      → 41F(6,2)（= 口袋正上方，FLY_LAND[41] 也是 (6,2)）。
    #      simplest 走法：外区退回 (6,11) 上行梯 → 42F → fly(41) 直接落 (6,2)。
    #    北入口代价：(6,4) 左右 (5,4)(7,4) 双魔導師 obj58 → HP 减半。
    #    HP 账：事件后 HP≈1073；41F 前方还有 2 个青药(+2000) + 4 个红药(+1000) 可先收。
    if not fly(w, 42, 'V82 38F→42F（南入41F，跳过空跑的 47F）'): return 1
    if not stair(w, 6, 11, 'V82 42F(6,11)→41F(6,10)'): return 1
    if os.environ.get('MOTA_PROBE_AT_41F'):
        pf = os.environ.get('MOTA_PROBE_AT_41F')
        if pf == 'HP':
            _hp_scan(w)
            return 0
        for _pf in pf.split(','):
            _dump_floor(w, int(_pf))
        return 0
    #   只花 3 黄进 3 扇入口门 (6,9)(6,8)(6,7)；进去后西袋/东袋各 1 黄门，"以门换钥"自筹：
    #     西袋 (4,8) 黄门 → (4,9)(3,9)红药+250 (3,10)(4,10)(3,11) 黄钥×3 (4,11) 赤晶 A+5
    #     东袋 (8,8) 黄门 → (8,9)(9,9)红药+250 (8,10)(9,10)(9,11) 黄钥×3 (8,11) 青晶 D+5
    #   净收益：黄钥 +6-2=+4，红药 +500，A+5 D+5。
    if not need(w, y=3, label='41F 入口 3黄门(6,9)(6,8)(6,7)'): return 1
    if not run(w, [
        (6, 9, '黄门(6,9) -1黄'),
        (6, 8, '黄门(6,8) -1黄'),
        (6, 7, '黄门(6,7) -1黄'),
        (6, 6, '到(6,6)（y6 中心）'),
    ], 'V82'): return 1
    # 西袋
    if not run(w, [
        (5, 6, '蓝门(5,6) -1蓝'),
        (4, 6, ''), (4, 7, ''),
        (4, 8, '黄门(4,8) -1黄'),
        (4, 9, ''), (3, 9, '★红药(3,9) +250HP'),
        (3, 10, '★黄钥(3,10) +1黄'),
        (3, 11, '★黄钥(3,11) +1黄'),
        (4, 11, '★赤晶(4,11) +5ATK'),
        (4, 10, '★黄钥(4,10) +1黄'),
        (4, 9, ''), (4, 8, ''), (4, 7, ''), (4, 6, ''),
    ], 'V82'): return 1
    if not run(w, [
        (3, 6, '到(3,6)（邻接魔術師B -100）'),
        (3, 5, '魔術師B(3,5)'),
        (3, 4, '黄门(3,4) -1黄'),
        (3, 3, '到(3,3)'),
        (3, 2, '到(3,2)（邻接魔術師A -200）'),
        (2, 2, '★杀魔術師A(2,2)（暗墙事件前提1）'),
        (3, 2, '回(3,2)'),
        ('dirs', '>^<v', '左支线蓝钥绕行'),
        (3, 3, '回(3,3)'), (3, 4, '回(3,4)'),
        (3, 5, '回(3,5)'), (3, 6, '回(3,6)'), (4, 6, '回(4,6)'),
    ], 'V82'): return 1
    # 东袋
    if not run(w, [
        (5, 6, ''), (6, 6, ''),
        (7, 6, '蓝门(7,6) -1蓝'),
        (8, 6, ''), (8, 7, ''),
        (8, 8, '黄门(8,8) -1黄'),
        (8, 9, ''),
        ('dirs', 'vv>^^<', '4246vv>^^<4254'),
        (8, 8, ''),
        (8, 7, ''), (8, 6, ''),
    ], 'V82'): return 1
    print('  %-26s %s' % ('V82-s 41F南侧扫荡毕', st(h)))

    #    与左支线（已前移到西袋回程(4,6)后）镜像；原 goto(6,10) 折返 + 事件段走位整段删除。
    if not need(w, y=1, label='41F 事件剩余 1黄门(9,4)'): return 1
    if not run(w, [
        (9, 6, '到(9,6)（邻接魔術師B -100）'),
        (9, 5, '魔術師B(9,5)'),
        (9, 4, '黄门(9,4) -1黄'),
        (9, 3, '到(9,3)'),
        (9, 2, '到(9,2)'),
        (10, 2, '★撞暗墙(10,2)→刷魔術師A→杀之→事件完成（y6三格变墙 / (5,7)(7,7)变地板 / (6,5)生翼）'),
        (9, 2, '回(9,2)'),
        ('dirs', '<^>v', '4292<^>v4293'),
        (9, 3, '回(9,3)'), (9, 4, '回(9,4)'),
        (9, 5, '回(9,5)'), (9, 6, '回(9,6)'),
        ('dirs', '<', '左接4273(8,6)'),
    ], 'V82'): return 1
    print('  %-26s %s' % ('V82 41F暗墙事件完成', st(h)))

    # ④ 事件后：从 (8,6) 沿 y7 新走廊（(7,7) 已变地板）退回 (6,11) 上行梯 → 42F
    #    ⚠️ 不可从 (7,6) 南回：事件已把 (5,6)(6,6)(7,6) 三格变墙。
    if not run(w, [
        (8, 7, '★到(8,7)（Ｋスライム obj98，y7 走廊唯一入口，绕不开）'),
        (7, 7, '★到(7,7)（事件后变地板，y7 新走廊）'),
        (6, 7, '到(6,7)（黄门已开）'),
        (6, 8, '到(6,8)'), (6, 9, '到(6,9)'), (6, 10, '到(6,10)'),
    ], 'V82'): return 1
    print('  %-26s %s' % ('V82 退回41F南', st(h)))
    # ⑤ 北入口取翼（**先取翼、后补血**：夹击=ceil(HP/2) 比例减半 → HP 越低损得越少）
    #    夹击只发生 1 次（踏入(6,4)时两侧魔導師都在）；回程不再夹击（同格已判过一次 + 引擎按「左右都是」才夹）。
    #      但夹击判定要求左右两格**都**是魔導師（mota_core.MAGIC_SANDWICH 口径），
    #      且同一格夹击只算一次 → 回程根本不需再杀。而 41F 口袋之后要打 42F(3,8) 吸血コウモリ(-184)，
    #      HP 已被 32F 两只門番Ｂ(-432) 等落穴合法化成本压低 716，再扣 244 就跌破 184 打不动。
    #      ➜ 改为「拿翼即走，不碰 (5,4)」，省 244HP，(7,4) 魔導師留作日后赚钱目标。
    if not stair(w, 6, 11, 'V82 41F(6,11)上行梯→42F'): return 1
    if not fly(w, 41, 'V82 42F→41F fly 落(6,2)（口袋内）'): return 1
    print('  %-26s %s' % ('V82 落口袋(6,2)', st(h)))
    if not run(w, [
        (6, 3, '到(6,3)'),
        (6, 4, '⚠️到(6,4)：左右(5,4)(7,4)双魔導師 obj58 → HP减半（仅此一次夹击）'),
        ('dirs', '<>', '4307<>4308'),
        (6, 5, '★拿降臨翼 obj108(6,5)'),
        (6, 4, '回(6,4)（同格不重复夹击）'),
        ('dirs', '><', '4289><4290 杀右魔導師(7,4)+100G'),
        (6, 3, '回(6,3)'), (6, 2, '回(6,2)'),
    ], 'V82'): return 1
    print('  %-26s %s' % ('V82 ★拿降臨翼', st(h)))
    #    （口袋内 (6,2) 贴 (6,1) 下行梯，仍可直接 fly 42F，见下段）
    if not fly(w, 42, 'V82 41F口袋(6,2)贴(6,1)下行梯→fly 42F'): return 1
    if not run(w, [
        (6, 9, '到(6,9)'), (6, 8, '到(6,8)'), (6, 7, '到(6,7)'),
        (6, 6, '到(6,6)'), (6, 5, '到(6,5)'), (5, 5, '到(5,5)'),
        (4, 5, '黄门(4,5) -1黄'),
        (3, 5, '到(3,5)'), (2, 5, '到(2,5)'), (1, 5, '到(1,5)'),
        (1, 6, '黄门(1,6) -1黄'),
        (1, 7, '到(1,7)'), (2, 7, '到(2,7)'), (3, 7, '到(3,7)'),
        (3, 8, '到(3,8)'), (3, 9, '到(3,9)'), (2, 9, '到(2,9)'),
        (1, 9, '★青药 obj78(1,9) +1000HP'),
    ], 'V82'): return 1
    print('  %-26s %s' % ('V82 42F青药+1000', st(h)))
    #   vv 下 (1,10)杀 obj97 蝙蝠 →(1,11)黄钥+1 →>(2,11)黄钥+1 →>(3,11)蓝晶 obj85 DEF+5
    #   →<<^^ 原路回 (1,9) 接原回程。多拿 2 把黄钥 + DEF+5 + 蝙蝠+50G，代价 8 步。
    for _ch in 'vv>><<^^':
        if not _step(w, {'v': (0, 1), '^': (0, -1), '<': (-1, 0), '>': (1, 0)}[_ch])[0]:
            print('  !! V82 42F 方向串 %s 受阻 (%d,%d)' % (_ch, h.x, h.y)); return 1
    print('  %-26s %s' % ('V82 42F 2黄钥+蓝晶DEF+5', st(h)))
    # ⑦ 回 42F 楼梯旁
    if not run(w, [
        (2, 9, '回(2,9)'), (3, 9, '回(3,9)'), (3, 8, '回(3,8)'),
        (3, 7, '回(3,7)'), (2, 7, '回(2,7)'), (1, 7, '回(1,7)'),
        (1, 6, '回(1,6)'), (1, 5, '回(1,5)'), (2, 5, '回(2,5)'),
        (3, 5, '回(3,5)'),
        ('dirs', '^^^<<', '4359^^^<<4368'),
    ], 'V82'): return 1

    # ⑧ 降臨翼：40F 有下行梯 → 在本层瞬移到梯旁（不消耗层间跳跃），故须先飞 1F 再用
    #    wing_down 规则：本层有下行梯 → 只瞬移到梯旁；1F 无下行梯 → 才真下到 0F。
    if not fly(w, 1, 'V82 40F→1F'): return 1
    lg = w.wing_down()
    if not lg or '降臨の翼' not in lg[0]:
        print('  !! 降臨翼失败:', lg)
        return 1
    print('  %-26s %s' % ('V82 1F降臨翼→0F', st(h)))
    if not run(w, [(6, 6, '★0F 幸运金币 obj113（金币×2）')], 'V82'): return 1
    print('  %-26s %s' % ('V82 拿幸运金币', st(h)))
    if not goto(w, 1, 2, 'V82 回0F(1,2)'): return 1
    print('  %-26s %s' % ('V82 0F完成', st(h)))

    if os.environ.get('MOTA_STOP_AFTER_V801'):
        print('   V81 结束位置确认: %s' % st(h))
        pf = os.environ.get('MOTA_PROBE_FLOOR')
        if pf:
            for _pf in pf.split(','):
                _dump_floor(w, int(_pf))
        return 0

    # V83：**全塔 0 战损清场巡回**（用户定序二次修正：
    #   「你都拿了幸运金币了，该打扫战场了」「清零战损怪哪里麻烦了？你可以珠飞」。
    #   商店买镐差 1739G，先珠飞全塔清 0 战损怪（快照清单金币×2 合计 ~2096G，
    #   但其中 40F obj90 等是 V68 已清的误报——清扫前用活地图 w.at 复核，实测只清还活着的）
    #   攒够 4000G 再回 47F 商店。巫师群/低战损怪仍留到神盾 obj39 之后（V88 段）。
    #   实现：fly() 逐层 → 清扫 → **goto 回 FLY_LAND 落点（楼梯旁）再飞下一层**。）
    print('--- V83 全塔 0战损清场巡回（珠飞） ---')

    def _zero_targets(w, fl):
        """该层「0 战损可白刃」的怪清单（只读，不改任何状态）。"""
        import math as _m
        A, D = w.hero.atk, w.hero.dfn
        out = []
        for y in range(1, 12):
            for x in range(1, 12):
                o = w.at(fl, x, y)
                if not o:
                    continue
                if M.TYPE.get(M.oatr(o, 3)) != 'MONSTER':
                    continue
                hp0, atk, dfn = M.oatr(o, 10), M.oatr(o, 11), M.oatr(o, 12)
                per = A - dfn
                if per <= 0:
                    continue
                t = _m.ceil(hp0 / per)
                if max(atk - D, 0) * (t - 1) == 0:
                    out.append((x, y, o))
        return out

    def _bfs_dist(w, fl, sx, sy):
        """层内 Dijkstra（与 goto 同权重：怪100/门25/空1）。供清扫排序与可达性预检共用。"""
        import heapq as _hq
        dist = {(sx, sy): 0}
        pq = [(0, sx, sy)]
        while pq:
            d, cx, cy = _hq.heappop(pq)
            if d > dist.get((cx, cy), 1e9):
                continue
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                n = (cx + dx, cy + dy)
                ok, wc = run_segs._cost(w, fl, n[0], n[1])
                if not ok:
                    continue
                nd = d + wc
                if nd < dist.get(n, 1e9):
                    dist[n] = nd
                    _hq.heappush(pq, (nd, n[0], n[1]))
        return dist

    def _zero_sweep(w, fl):
        """单层 0 战损怪清扫：读全图 → 对战损 0 的怪 goto（寻路自动绕开有代价格）。
        goto 失败（被堵）就跳过该怪。
        ⚠️ 清扫期间临时清零钥匙 → _cost 的 DOOR 分支 keys[col]>0 不成立 →
        寻路 100% 绕门不开门（用户红线：0 损清扫不得耗钥，3F 曾因此白开 2 黄门）。"""
        h = w.hero
        real_keys = (h.keys['y'], h.keys['b'], h.keys['r'])
        h.keys['y'] = h.keys['b'] = h.keys['r'] = 0
        #   否则 V83 清扫段每步的 ky 都被记成 0，前端看到钥匙「凭空消失又回来」。
        w.sweep_real_keys = real_keys
        try:
            targets = _zero_targets(w, fl)
            _skip = _SWEEP_SKIP.get(fl, set())
            if _skip:
                targets = [t for t in targets if (t[0], t[1]) not in _skip]
            #   Dijkstra（与 goto 同权重：怪100/门25/空1）算到所有剩余怪的距离，
            #   选最近的先杀。替代原 (y,x) 扫描序（15F 曾因此两次 x6 竖列往返，
            #   116 步 → 串成一条链约 51 步，省 ~65 步）。
            #   钥匙已临时清零 → 寻路 100% 绕门，距离估计与实际执行一致。
            while targets:
                ds = _bfs_dist(w, fl, h.x, h.y)
                _dsl = [ds.get((x, y), 1e9) for (x, y, _o) in targets]
                best = _dsl.index(min(_dsl))
                x, y, o = targets.pop(best)

                # 复核仍在（可能被顺路打掉）
                if w.at(fl, x, y) != o:
                    continue
                if not goto(w, x, y, 'V83 %dF 零损清怪 obj%d(%d,%d)' % (fl, o, x, y)):
                    print('  .. V83 %dF obj%d(%d,%d) 跳过（不可达/被堵）' % (fl, o, x, y))
                #   杀 (7,6) obj95 スライムマン +60G（幸运金币×2），<v 下杀 (6,7) obj91 騎士
                #   +130G，^ 回 (6,6)，<<<<< 折回 (1,6) 接原 x1 列南下。
                #   净 +15 步换 +190G（买镐冗余 13→203，为后续砍段攒冗余）。
                #   ^^>^^<<^^>> 直穿 (9,5)第4守卫格→(10,1) 贴梯，接下一轮 fly36（原 i4404）。
                if fl == 33 and (x, y) == (9, 7):
                    for _ch in '^^>^^<<^^>>':
                        if not _step(w, _DMAP83[_ch])[0]:
                            print('  !! V83 33F 方向串 %s 受阻 (%d,%d)' % (_ch, h.x, h.y)); return False
                    print('  %-26s %s' % ('V83 33F 直插(10,1)贴梯', st(h)))
                if fl == 36 and (x, y) == (1, 5) and w.at(36, 7, 6) == 95:
                    for _ch in 'v>>>>>>':
                        if not _step(w, _DMAP83[_ch])[0]:
                            print('  !! V83 36F 支线 %s 受阻 (%d,%d)' % (_ch, h.x, h.y)); return False
                    for _ch in '<v':
                        if not _step(w, _DMAP83[_ch])[0]:
                            print('  !! V83 36F 支线 %s 受阻 (%d,%d)' % (_ch, h.x, h.y)); return False
                    print('  %-26s %s' % ('V83 36F 支线两只+190G', st(h)))
                    for _ch in '^<<<<<':
                        if not _step(w, _DMAP83[_ch])[0]:
                            print('  !! V83 36F 支线回程 %s 受阻 (%d,%d)' % (_ch, h.x, h.y)); return False
                    print('  %-26s %s' % ('V83 36F 支线折回(1,6)', st(h)))
            #   FLY_LAND 只是「飞进来的落点」，它挨着的那座楼梯未必最近 ——
            #   15F 清完在 (3,10)，走回 (6,10) 要 11 步，走到 (5,1)（贴 (6,1) 上梯）只要 10 步；
            #   19F/14F 同理（分别走回 (1,2)/(10,11) 都是绕远）。改取最近的梯邻格。
            if not goto_stair_adj(w, 'V83 %dF 就近贴梯' % fl):
                print('  !! V83 %dF 贴梯失败（无钥），巡回中止' % fl)
                return False
            return True
        finally:
            #   不碰钥匙，但若途中顺路拾到钥匙，旧代码会被恢复覆盖丢失）。
            h.keys['y'] = real_keys[0] + h.keys['y']
            h.keys['b'] = real_keys[1] + h.keys['b']
            h.keys['r'] = real_keys[2] + h.keys['r']
            w.sweep_real_keys = None

    #   但低层小怪「藏得深、金币少」：1F 25 步换 4G、4F 21 步换 2G、5F 69 步换 8G、
    #   8F 41 步换 2G —— 四层 156 步只换 16G（0.10 G/步），而 18F 47 步换 192G（4.09 G/步）。
    #   本段唯一目的是凑够 47F 商店的 4000G 买超级镐。经实测：买镐前总收入 4643G，
    #   因此只要保留高效层即可满足，低效层整层跳过。
    #   实测各层 G/步：18F 4.09 / 12F 2.67 / 15F 2.60 / 19F 2.39 / 20F 1.66 /
    #   14F 1.51 / 17F 1.38 / 10F 1.14 / 6F 0.65 / 9F 0.55 / 11F 0.53 /
    #   7F 0.46 / 1F 0.16 / 5F 0.12 / 4F 0.10 / 8F 0.05。
    #   现按 G/步 **降序** 访问（高效层先扫），并砍掉 ≤1.14 的低效层
    #   （10F 及以下），合计省 544 步、买镐前仍余 269G。
    _DMAP83 = {'<': (-1, 0), '>': (1, 0), '^': (0, -1), 'v': (0, 1)}   # ✅ 2026-11-20：28F/38F 方向串用
    #    0F 后首飞直接进 12F hook 轮再 33F。
    _SWEEP_FLOORS = [12,
                     33, 34, 36, 38]   # ✅ 2026-11-20（用户 #3094 支线提前杀 14F 两怪 + #4478~4491 砍 14F 轮）：
    #   深处 2 只 Ｂスライム(2,5)/(5,1) 太亏（~36 步换 +32G，0.9 G/步）跳过；
    #   20F/17F 整层（只 2 蝙蝠+1史莱姆+1大蝙蝠，飞行+绕行不划算）从清单删。
    #   14F 清完就近贴梯飞 33F（FLY_LAND[33]=(10,1)，与原 #4906 一致）。
    #   (7,6)obj95 スライムマン +60G / (6,7)obj91 騎士 +130G，改跳过这两只 —— 清扫完就近
    #   贴梯（36F 下行梯 (11,1) 邻格 (11,2)，从 (11,4) 正好 ^^ 两步）直接 fly38 落(2,1)。
    #   (7,3)obj46 上級僧侶 +44G（0 战损），从 (11,4) 直接 ↓↓↓ 到 (11,7) 贴梯续飞 15F。
    _SWEEP_SKIP = {14: {(2, 6), (5, 2)}, 36: {(7, 6), (6, 7)}, 12: {(7, 3)},
                   #    砍掉原西南大绕行打的 3 只：兵士(6,9)+90 / 兵士(1,10)+90 / 剣士(4,6)+110。
                   33: {(6, 9), (1, 10), (4, 6)},
                   #   40F 只保留 (9,10)obj93 兵士 +90G（买镐线关键），跳过深处
                   #   (7,9)(5,9) 两只 スライムマン 幽灵——由 38F 轮后的 28F 卖钥支线补金。
                   40: {(7, 9), (5, 9)},
                   #   三只（+250G），跳过 (10,10)obj91——清扫完 goto_stair_adj 就近贴上梯
                   #   (1,1) 旁 (1,2)，从那里飞 28F 卖 3 把；骑士 +130G 让位卖钥支线。
                   38: {(10, 10), (7, 6), (7, 7)},
                   #   太亏——买镐线 51G 冗余足够吸收）：SKIP 后 18F 清完就近贴梯直接飞 12F。
                   18: {(7, 9), (7, 10),
                        #   （绕 10 步 +48G）一并砍——杀完 (4,4) 从 (5,4) 东进 x6 列贴梯飞 12F。
                        (5, 9), (5, 10)},
                   #   一并砍掉，SKIP (10,10)obj7；15F 从 (6,2) 起扫后原 x6 列北上不变。
                   15: {(10, 10),
                       #   (1,10)大バット+24/(2,11)上級僧侶+44/(3,10)大バット+24 共 +92G，
                       #   26 步不值；打完 (2,1) ゾンビナイト后直接贴梯 fly20。
                       (1, 10), (2, 11), (3, 10)},
                   #   改方向串 ^^>><<vv 只顺路杀 (8,8) ゾンビナイト +60G，
                   #   (7,6) ロック +56G / (8,3) ゾンビナイト +60G 两只跳过（金币冗余够）。
                   19: {(7, 6), (8, 3)}}
    #   {目标层: 中转层}；中转后踩 (6,11) 下楼即到目标层的 WARP 落点。
    _SWEEP_RELAY = {14: 15}
    for _fl in _SWEEP_FLOORS:
        #   原先是无条件飞过去、落点站一步再飞去下一层（每层白 1 步，
        #   Toy 里就是「47F→1F→0F…」这种看不出目的的空跳）。
        _tg = _zero_targets(w, _fl)
        if not _tg and _fl != 12:
            continue
        #   口径与清扫一致：临时清零钥匙（寻路 100% 绕门），从 FLY_LAND 做 Dijkstra。
        _h = w.hero
        _rk = (_h.keys['y'], _h.keys['b'], _h.keys['r'])
        _h.keys['y'] = _h.keys['b'] = _h.keys['r'] = 0
        w.sweep_real_keys = _rk          # 录制器掩码（本段纯预检不产生步骤，双保险）
        try:
            if _fl in _SWEEP_RELAY:
                # WARP 值是 (目标层, x, y)，这里只要落点坐标
                _lx, _ly = M.WARP[(_SWEEP_RELAY[_fl], 6, 11)][1:]
            else:
                _lx, _ly = M.FLY_LAND[_fl]
            _ds = _bfs_dist(w, _fl, _lx, _ly)
        finally:
            _h.keys['y'], _h.keys['b'], _h.keys['r'] = _rk
            w.sweep_real_keys = None
        if not any(_ds.get((x, y), 1e9) < 1e9 for (x, y, _o) in _tg) and _fl != 12:
            print('  .. V83 %dF 目标全不可达（无钥绕门），跳过不飞' % _fl)
            continue
        #   19F→14F 不再直飞 14F(10,11)（离作业面 (6,8) 还有 7 步），
        #   改「珠飞 15F(6,10) → 踩 15F(6,11) 下落 → 14F(6,10)」，落地就贴着 x6 竖道，
        #   上两步即 (6,8)。_SWEEP_RELAY 记「去该层改由哪层中转」。
        if _fl != 12:   # ✅ 12F 只执行下方 hook，不 fly 不 sweep（用户 #4426~4446）
            if _fl in _SWEEP_RELAY:
                if not fly(w, _SWEEP_RELAY[_fl], 'V83 珠飞→%dF（中转）' % _SWEEP_RELAY[_fl]):
                    print('  !! V83 珠飞 %dF 失败，跳过该层' % _SWEEP_RELAY[_fl])
                    continue
                if not stair(w, 6, 11, 'V83 %dF 下楼→%dF' % (_SWEEP_RELAY[_fl], _fl)):
                    continue
            else:
                # 珠飞要求站楼梯旁；FLY_LAND 落点即上行梯旁踏出格 → 落地后可直接再飞
                if not fly(w, _fl, 'V83 珠飞→%dF' % _fl):
                    print('  !! V83 珠飞 %dF 失败，跳过该层' % _fl)
                    continue
            #   清扫器清零钥匙绕门 → 左上 (3,5)(1,5) 两只ロック 不可达跳过（-112G翻倍）。
            #   补：18F 轮 fly 落后手动 vv<<< 走进去，顺路杀 (5,4)兽人(+60翻倍)、开(4,4)黄门、到(3,4)，
            #   门已开 obj2→0，清扫器接手即可穿门打两ロック。省 V75 15步，兽人翻倍多赚30。
            if _fl == 18:
                for _ch in 'vv<<<':
                    if not _step(w, {'v': (0, 1), '<': (-1, 0)}[_ch])[0]:
                        print('  !! V83 18F 开门串 %s 受阻 (%d,%d)' % (_ch, h.x, h.y)); return 1
                print('  %-26s %s' % ('V83 18F 补开(4,4)黄门+兽人', st(h)))
            if not _zero_sweep(w, _fl):
                break
            print('  %-26s %s' % ('V83 %dF 清完' % _fl, st(h)))

        #   38F 只清 (1,3)(3,4)(4,4)（SKIP 掉 (10,10)骑士/两门后怪），清扫完
        #   → fly28 落 (10,11) → << 到 (8,11) → ^^^^^^ 到 (8,5) → 撞 (8,4) obj161
        #   卖 3 把黄钥 +300G → vvvvvv>> 回 (10,11) → fly40 落 (10,11)（SKIP 已排除两幽灵，
        #   只杀 (9,10) 战士 +90G）→ 就近贴梯 → fly39 下行 38F(10,1) 接方向串 +180G。
        #   金币账：3481(38F清完) +300(卖) +90(40F战士) +180(方向串) = 4051 ≥ 4000 买镐线。
        if _fl == 38:
            if not fly(w, 28, 'V83 38F→28F（卖钥匙）'): return 1
            # 28F：(10,11) << 到 (8,11)，^^^^^^ 上行到 (8,5)（商人 (8,4) 下邻）
            for _ch in '<<^^^^^^':
                if not _step(w, _DMAP83[_ch])[0]:
                    print('  !! V83 28F 方向串 %s 受阻 (%d,%d)' % (_ch, h.x, h.y)); return 1
            #   闭环 (1,11)(2,11) 多拿 2 把黄钥，卖前黄7（够卖5把），卖后黄2；终态仍留够通关。
            for _k in range(8):
                if not sell_keys(w, 1, 'V83 28F 商人卖钥第%d把' % (_k + 1)): return 1
            # vvvvvv>> 回 (10,11) 贴下行梯旁，再飞 40F
            for _ch in 'vvvvvv>>':
                if not _step(w, _DMAP83[_ch])[0]:
                    print('  !! V83 28F 回程方向串 %s 受阻 (%d,%d)' % (_ch, h.x, h.y)); return 1
            print('  %-26s %s' % ('V83 28F 卖3把+回程', st(h)))
        #   原路线 fly15 落 (6,10) → 绕右杀 obj7 バット(+6G) → 折回走 x6 列北上 8 步。
        #   改：fly16 落 (6,2) → ^ 踩 (6,1) 下行梯 → 15F(6,2) → < 到 (5,2) 接原 x6 列北上路线。
        #   楼梯 warp：16F(6,1)→15F(6,2)（M.WARP）。省 12F→15F 绕行+蝙蝠支线 ~16 步。
        if _fl == 12:
            #   原 fly16 落(6,2)→下楼15F→_zero_sweep(15) 杀兽人折回 (5,1) 全砍；
            #   18F 清完落 (6,2) 贴梯，直接 fly20 下 19F。
            #   原路线 15F 清完 (5,1) 贴梯 → fly19 落 (1,2) 绕 32 步打 3 只 +176G。
            #   改：fly20 落 (6,10) → v 踩 (6,11) 下行梯 WARP 19F(6,10) →
            #   ^^>><<vv 绕 (8,8) 只杀 ゾンビナイト +60G 回 (6,10)；
            #   (7,6) ロック / (8,3) ゾンビナイト 跳过（_SWEEP_SKIP[19]，金币冗余够）。
            #   之后循环下一轮 _fl=14 经 15F 中转下楼，(6,10) 恰是 19F 下行梯旁 → 直接 fly15。
            #   18F 清完落 (6,2) 已贴梯 → 下一轮 fly33 直接起飞，省 24 步；丢 19F 3 怪 +176G（冗余够）。
            pass

    #   砍 #4434~#4459：38F (7,2)↓(7,3..7,8) 开门打死霊兵士/剣士、取红药+青晶、再折返那段整段删除。
    #   代价：-180G、-200HP红药、-4DEF青晶、少开 1 黄门（省 1 黄钥，后续 28F 一起卖）。
    if not fly(w, 39, 'V83 40F→39F（中转下38F）'): return 1
    if not _step(w, (0, -1))[0]:
        print('  !! V83 39F(11,2)→(11,1) 下楼失败'); return 1
    _DMAP = {'<': (-1, 0), '>': (1, 0), '^': (0, -1), 'v': (0, 1)}
    print('  %-26s %s' % ('V83 39F中转→38F(10,1) 直接飞', st(h)))
    # 方向串打怪补金币后 → 飞 48F 下楼到 47F(1,2)
    if not fly(w, 48, 'V83 38F→48F'): return 1
    if not _step(w, (0, 1))[0]:
        print('  !! V83 48F(11,10)→(11,11) 下楼失败'); return 1
    print('  %-26s %s' % ('V83 飞48F下楼→47F(1,2)', st(h)))
    print('--- V84 47F 开路去商店（巫师群留到神盾后，见 V87 神圣盾段） ---')
    #   (9,11)→(1,2) 跳过：红晶(6,10)A+5 / 红药(4,10)HP+250 / 魔術師Ｂ(5,11) / 魔術師Ａ(1,9)
    #   / 黄门(8,11)(7,11)(3,11) 都不再取，直接 (1,2)→(2,1) 转东去商店。
    if not run(w, [
        (2, 1, '到(2,1) 转东'),
        (3, 1, '蓝门(3,1) -1蓝'), (4, 1, '到(4,1)'),
    ], 'V83'): return 1
    # 商店 (5,2)：从 (4,1) 南下到邻格 (4,2)，面朝 (5,2) 触发购物（不踏进 NPC 格）
    #   照 V77/V25 做法：站邻格 (4,2) 后 w.move(1,0) 朝商店原地触发，英雄停 (4,2)。
    if not goto(w, 4, 2, 'V84 47F 商店邻格(4,2)'): return 1
    _lg = w.move(1, 0)            # 朝 (5,2) 商店触发购物，英雄仍停 (4,2)
    if not _lg or not any('购物 obj170' in s for s in _lg):
        print('  !! V84 47F 购物失败:', _lg); return 1
    print('   V83 完成（超级镐 obj112 到手）: %s' % st(h))

    # V83：回上行梯（原路），准备飞 37F 破墙取破壊の玉
    #   就地飞即可；原沿左/下边缘绕到 (10,11) 的 20 步纯走位（空日志）全部删除。
    if not run(w, [
        (4, 1, '回(4,1)'), (3, 1, '回(3,1)（蓝门已开）'), (2, 1, '到(2,1) 贴上行的(1,1) 就地飞'),
    ], 'V83'): return 1
    print('   V83 回到上行梯旁: %s' % st(h))

    # V85：珠飞 37F → 超级镐 obj112 拆整层真墙（37F 四库被整圈真墙围死、地震前无入口）
    #   ⚠️ 重排：37F 首访（V56，step 3975-4008）已清 4 只怪
    #     (9,11) 死霊兵士 / (3,11) スライムマン / (1,9) 兵士 / (9,1) 兵士，并已拿
    #     红药(1,6) + 青药(11,1) + 开黄门(3,1)/蓝门(1,3)。
    #     → 超级镐之后该层**只剩 x=11 竖列 3 只怪**：(11,3) 骑士 / (11,6) 剣士 / (11,9) 骑士。
    #   顺序改为：镐 → 最短路径收完全部 32 个战利品（全程不打架）→ 最后沿 x11 列依次打这 3 只
    #     → 回到 (11,10)（下行梯旁）直接飞 45F，省掉原来绕到 (1,2) 楼梯旁的多余往返。
    #   收集顺序由 _tsp37b.py 精确求解：破墙后内部 11x11 全通，战利品恰好落在 4 个
    #   「3x3 缺一格」方块里（右下缺(9,9)、左下缺(3,9)、左上缺(3,3)、右上缺(9,3)），
    #   块内枚举全部哈密顿路径 + 块序/出入口穷举 → **42 步**（4+7+2+7+2+7+2+7+4），
    #   是块连续假设下的最优解（跨块最小间隔 2，交叉往返只会更差）。
    #   先捡后打：先把 800×2 青药 + 200×11 红药 + 红晶×4(A+4) / 蓝晶×4(D+4) 全吃完，
    #   打怪时 ATK/DEF/HP 都在最高点 → 3 只怪总战损从 (A217/D206) 的 48 降到最低。
    print('--- V85 珠飞 37F 超级镐拆墙 → 收全部战利品 → 最后打 x11 列三怪 ---')
    if not fly(w, 37, 'V85 珠飞→37F（落点(11,10)）'): return 1
    ok, lg = w.use_super_pick()
    for m in lg: print('  ' + m)
    if not ok: return 1
    # 收战利品：42 步最短蛇形（B1 右下 → B2 左下 → B3 左上 → B4 右上 → (11,2)）
    if not run(w, [
        (9, 8,  'B1 蓝晶 D+4'),
        (9, 7,  'B1 红晶 A+4'),
        (8, 7,  'B1 红晶 A+4'),
        (8, 8,  'B1 蓝晶 D+4'),
        (8, 9,  'B1 黄钥 +1黄'),
        (7, 9,  'B1 青药 +800HP'),
        (7, 8,  'B1 蓝晶 D+4'),
        (7, 7,  'B1 红晶 A+4'),
        (5, 7,  'B2 青药 +800HP'),
        (5, 8,  'B2 黄钥 +1黄'),
        (5, 9,  'B2 蓝钥 +1蓝'),
        (4, 9,  'B2 蓝钥 +1蓝'),
        (4, 8,  'B2 黄钥 +1黄'),
        (3, 8,  'B2 黄钥 +1黄'),
        (3, 7,  'B2 蓝晶 D+4'),
        (4, 7,  'B2 红晶 A+4'),
        (4, 5,  'B3 黄钥 +1黄'),
        (3, 5,  'B3 黄钥 +1黄'),
        (3, 4,  'B3 红药 +200HP'),
        (4, 4,  'B3 红药 +200HP'),
        (4, 3,  'B3 红药 +200HP'),
        (5, 3,  'B3 红药 +200HP'),
        (5, 4,  'B3 黄钥 +1黄'),
        (5, 5,  '★破壊の玉 obj105 到手'),
        (7, 5,  'B4 红钥匙 obj28 +1红'),
        (7, 4,  'B4 红药 +200HP'),
        (7, 3,  'B4 红药 +200HP'),
        (8, 3,  'B4 红药 +200HP'),
        (8, 4,  'B4 红药 +200HP'),
        (8, 5,  'B4 黄钥 +1黄'),
        (9, 5,  'B4 黄钥 +1黄'),
        (9, 4,  'B4 红药 +200HP'),
        #   破墙后 (10,4)(11,4) 都是地板 → (9,4)→(10,4)→(11,4) 两步直达。
        #   原来绕到 (11,2) 再南下打 (11,3)，那两步纯属多余：
        #   打完 (11,3) 本来就要往南经过 (11,4)，所以从 (11,4) 北上打 (11,3) 不浪费。
        #   整段 40+10=50 步（原 42+10=52）。
        (11, 4, '东行到(11,4)：战利品全收完'),
    ], 'V85'): return 1
    # 最后三只怪：(11,4) 北上打 (11,3) → 折返南下顺路清 (11,6)(11,9) → (11,10)
    if not run(w, [
        (11, 3, '骑士(11,3) HP160 A230 D105'),
        (11, 4, '回(11,4)（南下必经）'),
        (11, 5, '到(11,5)'),
        (11, 6, '剣士(11,6) HP100 A680 D50 → 1 回合 0 损 +110G'),
        (11, 7, '到(11,7)'),
        (11, 8, '到(11,8)'),
        (11, 9, '骑士(11,9) HP160 A230 D105'),
        (11, 10, '回(11,10) 下行梯(11,11)旁'),
    ], 'V85'): return 1
    print('   V85 完成（破壊の玉+红钥+32 战利品收齐 → 三怪清 → 回(11,10)）: %s' % st(h))

    #   45F 结构（dump 实证）：翼 obj107(2,10)；y2 行只有 (6,2) 黄门开口；中列 x6 被黄门(6,6) 分两段；
    #   (4,7) 黄门西接 (3,7)(2,7)；红门(2,8) 南下 (2,9)→翼(2,10)。
    #   路线：(11,1)→(6,1)→黄门(6,2)→(6,3)(6,4)(6,5)→黄门(6,6)→(6,7)→(5,7)→黄门(4,7)
    #         →(3,7)→(2,7)→红门(2,8)→(2,9)→★翼(2,10)  ＝ 3黄+1红，沿途巫师格 (5,3)(7,3)(5,5)(7,5)
    #         全在墙隔房间内不邻接主路 → 零战损。
    #   返程：翼格 (2,10) 中心对称 = (10,2)，但 (10,2) 不邻梯；故先下走一格到 (2,11)，
    #         其中心对称 (12-2, 12-11) = **(10,1)**（地板）→ 正好邻上行梯 (11,1)。中心飞行器飞出。
    #   飞行器配额：拾取 3 次，已用 2（41F×1 + 47F×1）→ 本段用第 3 次（最后 1 次）。
    print('--- V86 45F 取昇華の翼（3黄门+1红门，中心飞行器飞出）---')
    #   原代码要先走 (4,5)(3,5) 黄钥 → (2,5)(1,5)(1,4) → 蓝门(1,3) → (1,2) 楼梯旁，
    #   但 (4,5)(3,5) 黄钥已在 V85 收集段拿过、(1,3) 蓝门 V56 首访已开、
    #   且破墙后 (2,2) 已通 → 那段纯绕路（约 12 步），删除。
    if not fly(w, 45, 'V86 珠飞→45F（落点(2,1)）'): return 1
    if not run(w, [
        (6, 1, 'y1 西行到(6,1)'),
        (6, 2, '黄门(6,2) -1黄'),
        (6, 3, '到(6,3)'), (6, 4, '到(6,4)'), (6, 5, '到(6,5)'),
        (6, 6, '黄门(6,6) -1黄'),
        (6, 7, '到(6,7)'), (5, 7, '到(5,7)'),
        (4, 7, '黄门(4,7) -1黄'),
        (3, 7, '到(3,7)'), (2, 7, '到(2,7)'),
        (2, 8, '红门(2,8) -1红'),
        (2, 9, '到(2,9)'), (2, 10, '★昇華の翼 obj107(2,10) 到手'),
    ], 'V86'): return 1
    #   该格是地板且邻上行梯 (11,1) → 中心飞行器直接落在上楼梯旁。
    #   ⚠️ 更正：旧注释按 (2,10) 算出 (10,2) 并写「(10,2)→(10,1)→(11,1)」，
    #   与实际出发点 (2,11) 不符；(10,2)→(10,1) 那一步从来不存在。
    if not run(w, [(2, 11, '下走一格到(2,11)（中心对称=10,1 邻上行梯）')], 'V86'): return 1
    lg = w.wing_center()
    if not lg or '无法' in lg[0] or '尚未' in lg[0] or '已用完' in lg[0]:
        print('  !! V86 中心飞行器失败:', lg); return 1
    if (h.x, h.y) != (10, 1):
        print('  !! V86 中心飞行器落点异常，应为 (10,1)，实到 %s' % st(h)); return 1
    print('  %-26s %s' % ('V86 中心飞行器(2,11)→(10,1)', st(h)))

    # V87：43F 昇華の翼 force_layer 上 44F（幻之阶，无下行梯）→ 破坏之玉炸双門番A → 神圣盾
    #   44F（dump 实证）：(6,6) 神圣盾 obj39、(6,5)(5,6)(7,6)(6,7) 红药250×4、
    #   (6,8) 落穴 obj20、(5,9)(7,9) 門番A obj102 ×2（守 (6,8) 落穴格）。
    #      不是清整层。而 (5,9)(7,9) 恰好分列 (6,9) 左右 → 站 (6,9) 一次同时炸掉两只，
    #      落穴 (6,8) 的守卫随之清空、可通行。故路线改为「先绕到 (6,9) 再炸」。
    #      (5,9) 是怪格挡路，从 (4,9)→(4,10)→(5,10)→(6,10)→(6,9) 绕过去。
    print('--- V87 43F 昇華の翼上 44F → 破坏之玉站(6,9)炸双門番A → 神圣盾 obj39 ---')
    #   ① 中心飞行器落点 45F(10,1) 本就贴上行梯 (11,1)，无需 stair→46F 中转，
    #      直接珠飞 43F（落点 (1,2)），省掉 9 步西行 + 踩梯（#5623~#5632）。
    #   ② 43F 聖盾 obj38(9,4) 支线整段删除（#5634~#5659，26 步）：后期 A416/D400 下
    #      后续战损全部为 0，聖盾 D+50 非必需（以构建 rc=0 + 终态核对验证）。
    #      43F 落点 (1,2) 直接 wing_up force_layer 上 44F（落点仍 (1,2)）。
    if not fly(w, 43, 'V87 45F(10,1)直接珠飞→43F（落点(1,2)，跳过46F中转）'): return 1
    lg = w.wing_up(force_layer=True)                  # 43F→44F 幻之阶强制上飞
    if not lg or '昇華の翼' not in lg[0]:
        print('  !! V87 昇華の翼失败:', lg)
        return 1
    print('  %-26s %s' % ('V87 昇華の翼 43F→44F', st(h)))
    # 绕到 (6,9)：破坏之玉四邻 = (5,9) 左 + (7,9) 右 + (6,8) 落穴 + (6,10) 空
    if not run(w, [
        (1, 3, '到(1,3)'), (1, 4, '到(1,4)'), (1, 5, '到(1,5)'),
        (1, 6, '到(1,6)'), (1, 7, '到(1,7)'), (1, 8, '到(1,8)'),
        (1, 9, '到(1,9)'), (2, 9, '到(2,9)'), (3, 9, '到(3,9)'),
        (4, 9, '到(4,9)'),
        (4, 10, '南下绕开 (5,9) 門番A'),
        (5, 10, '到(5,10)'), (6, 10, '到(6,10)'),
        (6, 9, '到(6,9)：左右各一只門番A'),
    ], 'V87'): return 1
    ok, lg = w.use_bomb()
    for m in lg: print('  ' + m)
    if not ok: return 1
    if (h.f, 5, 9) not in w.cleared or (h.f, 7, 9) not in w.cleared:
        print('  !! V87 破坏之玉后双門番A 未清空，站位或机制有误'); return 1
    # 内室十字阵唯一入口 = 南端 (6,8) 落穴（GUARD_TO_PITS：双門番A清→落穴清）。
    if not run(w, [
        (6, 8, '落穴(6,8) 守卫已清 → 可通行'),
        (6, 7, '★红药250(6,7) +250HP'),
        (6, 6, '★神圣盾 obj39(6,6) D+100'),
        (6, 5, '★红药250(6,5) +250HP'),
        (5, 6, '★红药250(5,6) +250HP'),
        (6, 6, '回(6,6)'), (7, 6, '★红药250(7,6) +250HP'),
    ], 'V87'): return 1
    # 离开 44F：十字阵原路退出（南口）→外圈北上→(1,1) 上行梯 WARP→45F(2,1)
    if not run(w, [
        (6, 7, '回(6,7)'), (6, 8, '回(6,8)'), (6, 9, '回(6,9)'),
        (5, 9, '回(5,9)'), (4, 9, '回(4,9)'), (3, 9, '回(3,9)'),
        (2, 9, '回(2,9)'), (1, 9, '回(1,9)'),
        (1, 8, '到(1,8)'), (1, 7, '到(1,7)'), (1, 6, '到(1,6)'),
        (1, 5, '到(1,5)'), (1, 4, '到(1,4)'), (1, 3, '到(1,3)'), (1, 2, '到(1,2)'),
    ], 'V87'): return 1
    #   再飞——V88 直接从 44F(1,2) 珠飞 42F（fly 校验贴梯即可，落点 (6,10) 不变），省 1 步。
    print('   V87 完成（神圣盾 D+100 + 红药250×4，停 44F(1,2) 待飞）: %s' % st(h))
    if os.environ.get('MOTA_STOP_AFTER_V806'):
        print('   V87 结束位置确认: %s' % st(h))
        pf = os.environ.get('MOTA_PROBE_FLOOR')
        if pf:
            for _pf in pf.split(','):
                _dump_floor(w, int(_pf))
        return 0

    # V88：珠飞 42F 取红钥匙(6,2)。42F 中列北上：(6,10)落点→(6,9)(6,8)(6,7)(6,6)(6,5)
    #   →★黑骑士 obj101(6,4) -756 → ★红钥(6,2)。返程原路回 (6,10)（珠飞落点=楼梯(6,11)旁）。
    #   黑骑士 180/430/210：per=233-210=23, ceil(180/23)=8, 被击 (430-322)*7=756。
    print('--- V88 珠飞 42F 取红钥匙(6,2)（黑骑士(6,4) 必打） ---')
    if not fly(w, 42, 'V88 珠飞→42F（落点(6,10)）'): return 1
    if not run(w, [
        (6, 9,  '到(6,9)'), (6, 8, '到(6,8)'), (6, 7, '到(6,7)'),
        (6, 6,  '到(6,6)'), (6, 5, '到(6,5)'),
        (6, 4,  '★黑骑士 obj101(6,4) -756'),
        (6, 3,  '到(6,3)'), (6, 2, '★红钥匙 obj28(6,2) +1红'),
    ], 'V88'): return 1
    if not run(w, [
        (6, 3, '回(6,3)'), (6, 4, '回(6,4)（已清）'), (6, 5, '回(6,5)'),
        (6, 6, '回(6,6)'), (6, 7, '回(6,7)'), (6, 8, '回(6,8)'), (6, 9, '回(6,9)'),
        (6, 10, '回珠飞落点(6,10) 楼梯(6,11)旁'),
    ], 'V88'): return 1
    print('   V88 完成（红钥匙 +1红）: %s' % st(h))

    # V89：珠飞 48F（已到访）→ (1,10)（楼梯(1,11)旁，途中 (9,4) 魔導師夹击阵需神盾）
    #   → stair(1,11) WARP→49F(2,11) → 红门(3,11) -1红 → (6,11)→(6,10)→落穴(6,9)
    #   →(6,8)→落穴(6,7)→(6,6)。49F 进层触发：ゼノ obj57(6,3) + 8只 obj58 十字围。
    #   十字封印链（4 正方向警卫必打、4 斜角 (5,2)(7,2)(5,4)(7,4) 一格不踩）：
    #     ①打(6,4)：(6,6)→(6,5)→(6,4)
    #     ②打(5,3)：经(5,5)(4,5)(4,4) 绕开(5,4) →(4,3)攻击位
    #     ③打(6,2)：经(4,2)(4,1)(5,1) 顶行绕开(5,2) →(6,1)攻击位
    #     ④打(7,3)：经(7,1)(8,1)(8,2) 东列绕开(7,2) →(8,3)攻击位
    #     → 封印成立 obj57 改写 800/500/100 → ④打完 (7,3) 直接左进一步 (6,3) 打ゼノ（东十字位已空）
    #   警卫 230/450/100：per=133 t=2 每只 -128；ゼノ 800/500/100：per=133 t=7 被击 178*6=1068。
    #   战后摆出（仅摆到格子上，未拾取；拾取见 V90）：
    #     3蓝药78(5,5)(6,5)(7,5) + 3红晶82(2,4)(3,4)(4,4) + 3蓝晶85(8,4)(9,4)(10,4)
    #     + 红钥28(5,2) + 屠龙匕109(7,2) + 评分NPC(6,3)。斜角(5,2)(7,2) 被道具顶替、斜角(5,4)(7,4) 仍存。
    print('--- V89 珠飞 48F → 49F → 十字封印 → 打ゼノ（战后道具摆出） ---')
    if not fly(w, 48, 'V89 珠飞→48F（落点(11,10)）'): return 1
    #   改：goto(7,7) + 方向串 <<<^^ 走 (6,7)(5,7)(4,7)(4,6)(4,5) 到 (4,5)（墙已凿开），
    #   再 goto(1,10) 续接。比原绕行省 2 步。
    if not goto(w, 7, 7, 'V89 48F→(7,7)'): return 1
    _DMAP89 = {'<': (-1, 0), '>': (1, 0), '^': (0, -1), 'v': (0, 1)}
    for _ch in '<<<^^':
        _lg = w.move(*_DMAP89[_ch])
        # move 成功返回 log（可能为空 list，如空地移动；开门/商店返回非空但不移动）；
        # 失败返回 ['blocked:...'] / ['无...钥匙...'] / ['买不起...'] 等。按“是否含失败标记”判。
        if any(('blocked' in str(s)) or ('钥匙' in str(s) and '无' in str(s)) or ('买不起' in str(s)) for s in _lg):
            print('  !! V89 48F方向串 <<<^^ 在 %s 处受阻 (%d,%d): %s' % (_ch, h.x, h.y, _lg))
            return 1
    print('   48F (7,7)<<<^^到(4,5): %s' % st(h))
    if not goto(w, 1, 10, 'V89 48F (4,5)→(1,10) 楼梯(1,11)旁'): return 1
    print('   48F 穿越: %s' % st(h))
    if not stair(w, 1, 11, 'V89 (1,11) 上行梯 → 49F(2,11)（首次到访，不可珠飞直达）'): return 1
    #   (6,9) 落穴守卫 = 魔術師Ａ(5,10)(7,10)； (6,7) 落穴守卫 = 黒騎士(5,8)(7,8)。
    #   引擎 PIT_GUARD_CLEAR 此前漏绑这两条，V89 旧走法直接踩落穴穿行。
    #   正确走法：先清 4 只守卫，再踩落穴。守卫战损（per=ATK233-DEF100=133，
    #   魔術師Ａ 150/230/100 → 2回合 -130×1；黒騎士 180/430/210 → 8回合 -208×7=1456 太重，
    #   但 V89 时已有屠龙匕/圣盾，黒騎士伤害按实际算）：
    #   ① 沿 y11 到 (5,11)，向上清 (5,10) 魔術師Ａ → ② 清 (7,10) → ③ 清 (5,8) 黒騎士 → ④ 清 (7,8)
    #   → ⑤ 踩 (6,9) 落穴（守卫已清）→ ⑥ 踩 (6,7) 落穴（守卫已清）→ (6,6)
    if not run(w, [
        (3, 11, '红门(3,11) -1红'), (4, 11, '到(4,11)'), (5, 11, '到(5,11)'),
        (5, 10, '①守卫 魔術師Ａ(5,10) -130'),
        (6, 10, '到(6,10)'),         (7, 10, '②守卫 魔術師Ａ(7,10) -130 → (6,9)落穴守卫全清'),
        #   全清后落穴消失；原走法 (7,10)→(7,9) 撞墙（terrain=1 实心），改为回 (6,10) 经 (6,9) 进内部。
        (6, 10, '回(6,10)'), (6, 9, '落穴(6,9) 守卫已清 → 消失'),
        (6, 8,  '到(6,8)'), (7, 8, '③守卫 黒騎士(7,8)'),
        (6, 8,  '回(6,8)'), (5, 8, '④守卫 黒騎士(5,8) → (6,7)落穴守卫全清'),
        (6, 8,  '回(6,8)'), (6, 7, '落穴(6,7) 守卫已清 → 消失'),
        (6, 6,  '到(6,6)'),
    ], 'V89'): return 1
    print('   V89 入层完成（ゼノ+8警卫登场）: %s' % st(h))
    # 封印链①：打 (6,4)
    if not run(w, [(6, 5, '到(6,5)'), (6, 4, '①打警卫(6,4) -128')], 'V89'): return 1
    # 封印链②：绕行打 (5,3)（经(5,5)(4,5)(4,4) 避开斜角(5,4)）
    if not run(w, [
        (6, 5, '回(6,5)'), (5, 5, '到(5,5)（战后蓝药位，当前地板）'),
        (4, 5, '到(4,5) 绕行'), (4, 4, '到(4,4) 绕行'), (4, 3, '到(4,3) 攻击位'),
        (5, 3, '②打警卫(5,3) -128'),
    ], 'V89'): return 1
    # 封印链③：顶行绕行打 (6,2)（避开斜角(5,2)）
    if not run(w, [
        (4, 3, '回(4,3)'), (4, 2, '到(4,2)'), (4, 1, '到(4,1)'),
        (5, 1, '到(5,1) 顶行'), (6, 1, '到(6,1) 攻击位'),
        (6, 2, '③打警卫(6,2) -128'),
    ], 'V89'): return 1
    # 封印链④：东列绕行打 (7,3)（避开斜角(7,2)）→ 封印成立
    if not run(w, [
        (6, 1, '回(6,1)'), (7, 1, '到(7,1) 顶行'), (8, 1, '到(8,1)'),
        (8, 2, '到(8,2) 东列'), (8, 3, '到(8,3) 攻击位'),
        (7, 3, '④打警卫(7,3) -128 → 封印成立 obj57→800/500/100'),
    ], 'V89'): return 1
    if not w.seal49:
        print('  !! V89 封印未成立，中止'); return 1
    print('   ★49F 十字封印成立: %s' % st(h))
    # 打ゼノ(6,3)：④打完 (7,3) 后该格已为空地，直接左进一步进 (6,3) 攻击（原排法经东列绕到 (6,4) 再进属多余，省 6 步）
    if not run(w, [
        (6, 3, '★打ゼノ(6,3) -1068 → 战后演出：蓝药×3+红晶×3+蓝晶×3+红钥+屠龙匕'),
    ], 'V89'): return 1
    if not w.zeno49_dead:
        print('  !! V89 ゼノ未击败，中止'); return 1
    # ⚠️ 注意：ゼノ战后只是把道具「摆到格子上」，英雄尚未拾取（109 in h.items 此时为 False）。
    #    实际到手在下一段 V90。此处不得写「到手」。
    print('   V89 完成（战后道具已摆出，尚未拾取）: %s' % st(h))

    # V90：49F 拾取战后道具。全程避开仍未死的斜角警卫 (5,4)(7,4)：
    #   (6,3)→(6,2)→★红钥28(5,2)→(6,2)→★屠龙匕109(7,2)→(8,2)(8,3) 东列南绕（避开斜角(7,4)；(7,2)直右到(8,2)均为地板，原绕(7,1)(8,1)多余2步）
    #   →★蓝晶85(8,4)(9,4)(10,4) D+15 →(9,4)(8,4)(8,5)→★蓝药78(7,5)(6,5)(5,5) HP+3000
    #   →(4,5) 绕开斜角(5,4)→★红晶82(4,4)(3,4)(2,4) A+15
    #   三蓝药位置在 y5 行、三红晶在 y4 行西侧，中间夹 (5,4) 斜角 → 必须经 (4,5) 上到 (4,4)。
    print('--- V90 49F 拾取战后道具（屠龙匕/红钥/三晶/三蓝药） ---')
    if not run(w, [
        (6, 2, '到(6,2)'),
        (5, 2, '★红钥 obj28(5,2) +1红'),
        (6, 2, '回(6,2)'),
        (7, 2, '★屠龙匕 obj109(7,2)（对魔龙 obj74 伤害×2）'),
        (8, 2, '到(8,2)'), (8, 3, '到(8,3)'),
        (8, 4, '★蓝晶 obj85(8,4) D+5'), (9, 4, '★蓝晶 obj85(9,4) D+5'),
        (10, 4, '★蓝晶 obj85(10,4) D+5'),
        (9, 4, '回(9,4)'), (8, 4, '回(8,4)'), (8, 5, '到(8,5)'),
        (7, 5, '★蓝药 obj78(7,5) HP+1000'), (6, 5, '★蓝药 obj78(6,5) HP+1000'),
        (5, 5, '★蓝药 obj78(5,5) HP+1000'),
        (4, 5, '到(4,5) 绕开斜角(5,4)'),
        (4, 4, '★红晶 obj82(4,4) A+5'), (3, 4, '★红晶 obj82(3,4) A+5'),
        (2, 4, '★红晶 obj82(2,4) A+5'),
    ], 'V90'): return 1
    if 109 not in h.items:
        print('  !! V90 屠龙匕未入包，中止'); return 1
    print('   V90 完成（屠龙匕已入包）: %s' % st(h))

    # V91：珠飞 35F → 打魔龙 obj74（屠龙匕伤害×2）→ 雪之结晶 obj110 → 三蓝药 800×3 → 回上行梯旁
    #   熔岩 obj79 **不可通行**（MTower.java @785 directCheck bl=false，撞上只弹 texts[183]）
    #   → 13F 神剣 obj34 唯一通路 = 雪之结晶 obj110（itemFlag==11，清四邻各 1 格、道具不消耗）
    #   → 雪之结晶必须杀 35F 魔龙才拿得到（35F(6,5) 事件写入，与魔龙 3×3 同层）
    #   魔龙 1500/600/250/800，带屠龙匕 mult=2：
    #     A248 → per=248*2-250=246，t=ceil(1500/246)=7，战损 (600-337)*6=1578
    #     （若先拿神剣 A348 → per=446 t=4 战损 789，但神剣需要雪之结晶、雪之结晶需要杀龙，
    #       循环依赖 → 只能 A248 先打龙。）
    #   ⚠️ V54 当时走 A* 绕开魔龙，(6,5) 雪之结晶 / (5,4)(6,4)(7,4) 蓝药 800 全都还在原地。
    print('--- V91 珠飞 35F：打魔龙 obj74 → 雪之结晶 obj110 → 三蓝药 800×3 ---')
    # 珠飞须站楼梯旁：V90 结束在 (2,4)，先走回 49F 下行梯(1,11) 旁的 (2,11)
    if not goto(w, 2, 11, 'V91 回 49F(2,11) 下行梯旁（珠飞前提）'): return 1
    if not fly(w, 35, 'V91 珠飞→35F（V53 已到访，落点(6,10)）'): return 1
    if not run(w, [
        (6, 9, '到(6,9)'), (6, 8, '到(6,8)'),
        (6, 7, '★魔龙 obj74（屠龙匕×2 per=246 t=7，-1578 / +800G）'),
        (6, 6, '到(6,6)'),
        (6, 5, '★雪之结晶 obj110（清 13F 熔岩的唯一道具，不消耗）'),
        (6, 4, '★蓝药 obj77(6,4) +800'),
        (5, 4, '★蓝药 obj77(5,4) +800'),
        (6, 4, '回(6,4)'),
        (7, 4, '★蓝药 obj77(7,4) +800'),
    ], 'V91'): return 1
    if 110 not in h.items:
        print('  !! V91 雪之结晶未入包，中止'); return 1
    if not goto(w, 6, 10, 'V91 绕回下行梯旁(6,10)（贴梯飞13F更省）'): return 1
    print('   V91 完成（雪之结晶 + 三蓝药，HP 净 +2400−1578）: %s' % st(h))

    # V92：珠飞 13F（V3 已到访）→ y11 石廊东行 (6,11) → 黄门 (6,10) -1黄
    #   → 沿 x6 列北上：每步先 use_snow_crystal() 清四邻熔岩，再前进 1 格
    #     站(6,10)清(6,9) → (6,9)清(6,8)(7,9)(5,9) → (6,8)清(6,7)(7,8)(5,8)
    #     → (6,7)清(6,6) → (6,6) → (6,5) 神剣 obj34 ATK+100
    #   ⚠️ 13F (6,10) 黄门在 V3 主线时未开（当时钥匙紧，走 y11 石廊直达上行梯）→ 本段补开。
    print('--- V92 珠飞 13F：雪之结晶清熔岩取神剣 obj34（ATK+100，零战损）---')
    if not fly(w, 13, 'V92 珠飞→13F（V3 已到访，落点(2,11)）'): return 1
    if not run(w, [
        (3, 11, '到(3,11)'), (4, 11, '到(4,11)'), (5, 11, '到(5,11)'),
        (6, 11, '到(6,11)'),
        (6, 10, '黄门(6,10) -1黄（V3 主线未开，此处补）'),
    ], 'V92'): return 1
    # 逐格清熔岩北上：站定 → 清四邻 → 前进一格
    for _ty in (9, 8, 7, 6, 5):
        ok, _lg = w.use_snow_crystal()
        if not ok:
            print('  !! V92 雪之结晶使用失败:', _lg); return 1
        for _m in _lg:
            print('     · ' + _m)
        if not run(w, [(6, _ty, '清熔岩后北上→(6,%d)' % _ty)], 'V92'): return 1
    if 34 not in h.items and w.at(13, 6, 5) == 34:
        print('  !! V92 神剣未取到'); return 1
    print('   V92 完成（神剣 ATK+100，零战损；雪之结晶仍在包内可复用）: %s' % st(h))

    # MOTA_STOP_AFTER_V92=1：跑到 V92 终点即停（配合 MOTA_PROBE_FLOOR=24,25,26 转储活层）
    if os.environ.get('MOTA_STOP_AFTER_V92'):
        print('   V92 终点: %s' % st(h))
        pf = os.environ.get('MOTA_PROBE_FLOOR')
        if pf:
            for _pf in pf.split(','):
                _dump_floor(w, int(_pf))
        if os.environ.get('MOTA_AUDIT_LOOT'):
            _audit_remaining_loot(w)
        pk = os.environ.get('MOTA_PICKLE_OUT')
        if pk:
            import pickle as _pk
            with open(pk, 'wb') as _f:
                _pk.dump(w, _f)
            print('   世界状态已存 → %s' % pk)
        return 0

    # ---------- V93: 41F-48F 漏捡清扫（补 ATK+30 / DEF+30 / HP+12600）----------
    #   V72-V90 清 42-49F 时只打怪/开门、漏下了这批 STATUS 道具：赤/青晶(+5攻/防) + 红蓝回复药。
    #   按「先打扫全塔 → 冲祭坛 → 祝福 → 圣水」原则，打大法师前先把这些加法增益全收了。
    CLEAN = {
        41: [(1, 1, 'HP250'), (1, 11, 'HP1000'), (3, 9, 'HP250'), (4, 11, 'ATK+5'),
             (8, 11, 'DEF+5'), (9, 9, 'HP250'), (11, 1, 'HP250'), (11, 11, 'HP1000')],
        42: [(3, 11, 'DEF+5')],
        43: None,  # ⚠️ 43F 特殊一笔画序（见下方 V93 43F 分支）
        45: [(1, 3, 'ATK+5'), (1, 5, 'DEF+5'), (2, 3, 'ATK+5'), (2, 5, 'DEF+5'), (11, 11, 'HP1000')],
        #   原 V93 在此之后清扫 46F(7,6)、47F(11,2)、48F 全 8 项，再飞回 46F(11,2)。
        #   该绕行 +240G 且当时金币已 7052 ≫ 献金 4960，纯属多余攒钱/攒属性路径。
        #   今只留 46F(1,2)(1,3) 两处顺路拾取，之后直接由 V94 从 46F 就地走向祭坛。
        46: [(6, 2, '到(6,2)接V94祭坛')],
    }
    print()
    print('--- V93 41F-48F 漏捡清扫（补 ATK+30 / DEF+30 / HP+12600）---')
    # ⚠️ 圣水 obj104（16F(11,11) 老人 obj154）需要 1 把黄钥（16F 迷宫无免费路），
    #    而这把黄钥恰好是 46F 祭坛区的门槛 —— 二者抢同一把。大法师必须打，故本段暂不收圣水；
    #    若要圣水，可在 12F(11,1) 商店花 1000G 买 1 黄钥（见文末说明）。
    # ⚠️ 41F 跳过：其迷宫黄门太多（去 (1,1) 花1把、去 (1,11) 再花2把），
    #    而 41F 那批只值 ATK+5/DEF+5/HP+3000，不值这么多黄钥（后续还要留给门）。
    #   （实测这一趟全程 HP/G 一位不变），原写法照旧飞过去、按 TSP 序绕一圈 64 步再飞走，
    #   纯空跑、全靠 _prune_loops 删。目标全空就整层跳过（连飞都不飞）。
    _T43 = [(11, 11, '蓝钥'), (4, 9, 'HP1000'), (4, 10, 'HP1000'),
            (4, 11, 'HP1000'), (11, 7, 'HP250'), (10, 8, '黄钥'), (6, 6, 'HP1000')]
    #   (3,11) DEF+5（goto 途中顺带 2 黄钥 +100G + NPC 对话），再 goto_stair_adj 绕到 (1,2)
    #   才能飞下一层。现 42F 那点 DEF+5 微不足道（A356/D389→389，HP8976 充裕），整段去掉：
    #   V93 直接从 13F 飞 45F，省 42 步。43F 目标已全清仍照旧跳过。
    for _f in (43, 45, 46):
        if _f == 43 and not any(w.at(43, x, y) for (x, y, _lab) in _T43):
            print('  .. V93 43F 目标已全清，跳过该层')
            continue
        if not goto_stair_adj(w, 'V93'):
            print('  !! V93 %dF 找不到可站的楼梯邻格' % h.f); return 1
        if not fly(w, _f, 'V93 飞 %dF' % _f): return 1
        if _f == 43:
            #   旧序 (4,9)(4,10)(4,11)(6,6)(11,7) 导致：① 开黄门(9,10) 穿口袋到 (7,11) 开蓝门
            #   ——蓝门从南侧直接开即可，口袋 3 步+1黄钥纯浪费；② 取完 (4,9) 三药后原路东返
            #   底部走廊再北上，双穿浪费。新序：先右上拿蓝钥(11,11)（顺路黄钥(10,8)）→
            #   南下开蓝门(6,11) 西取 3×HP1000 → 上 (11,7) HP250 → 中路 (6,6) → (1,10) 收尾。
            #   43F 全怪 @A348/D392 战损 0（obj101 仅 38），战斗不构成绕路约束。
            for (x, y, lab) in [(11, 11, '蓝钥'), (4, 9, 'HP1000'), (4, 10, 'HP1000'),
                                (4, 11, 'HP1000'), (11, 7, 'HP250'), (10, 8, '黄钥'), (6, 6, 'HP1000')]:
                if not goto(w, x, y, 'V93 43F(%d,%d) %s' % (x, y, lab)):
                    print('  !! V93 43F(%d,%d) %s 不可达 → 跳过' % (x, y, lab))
            continue
        if _f == 45:
            #   改走 x=3 竖列上下取 (2,5)(1,5)(2,3)(1,3) 四处水晶（方向串 ^^<<>>^^<<>>vvvv），
            #   落回 (3,7) 接原路 (4,7)→…→(11,11)。四处水晶/HP1000 全收，属性不变。
            _seq45 = [
                (3, 7, '至(3,7)'),
                (3, 6, ''), (3, 5, ''),
                (2, 5, '青水晶DEF+5'), (1, 5, '青水晶DEF+5'),
                #    砍掉原 (2,5)(3,5)(3,4黑骑士)(3,3)(2,3赤)(1,3赤) 6 步绕行。
                ('dirs', '^^', '4866^^4873'),
                (2, 3, ''), (3, 3, ''),
                (3, 4, ''), (3, 5, ''), (3, 6, ''), (3, 7, '回(3,7)'),
                #   goto 从 (3,7) 经 (7,7)→(11,11)（黄钥(11,7)+1 与黄门(11,8)-1 净抵），
                #   下一轮 goto_stair_adj 又从 (11,11) 经 (7,7) 折返楼梯 (10,1)——往返18步只换1000HP。
                #   删掉后四处水晶收齐回 (3,7)，直接 goto 楼梯，不再走 (7,7) 以东那段。
            ]
            for _it in _seq45:
                if _it[0] == 'dirs':
                    for _ch in _it[1]:
                        if not _step(w, {'^':(0,-1),'v':(0,1),'<':(-1,0),'>':(1,0)}[_ch])[0]:
                            print('  !! V93 45F 方向串 %s 受阻 (%d,%d)' % (_it[1], h.x, h.y)); return 1
                    continue
                x, y, lab = _it
                if not goto(w, x, y, 'V93 45F(%d,%d) %s' % (x, y, lab)):
                    print('  !! V93 45F(%d,%d) %s 不可达 → 跳过' % (x, y, lab))
            continue
        for (x, y, lab) in CLEAN[_f]:
            if not goto(w, x, y, 'V93 %dF(%d,%d) %s' % (_f, x, y, lab)):
                print('  !! V93 %dF(%d,%d) %s 不可达 → 跳过' % (_f, x, y, lab))
    print('   V93 完成（清扫后）: %s' % st(h))

    # ---------- V94: 46F 祭坛冲攻（大法师备战）→ 25F 大法师 obj96 → 5 红钥 ----------
    #   「打扫全塔 → 冲祭坛 → …」：清扫后把金币倒进 46F 祭坛（+10攻/次）抬 ATK，
    #   把大法师从 72 回合压到 40 回合（战损 11218→6162 < HP10699）。
    #   25F 红门 (6,10) 必经（BFS 实测），先花掉现有 1 红钥；大法师掉落 5 红钥。
    #   （920+1120+1340+1580=4960，剩 1672 < 第5次 1840）。实测 4 次（A421）即可：
    #   每回合 421-310=111 → 41 回合 → 战损 41×(560-405)=6355 < HP11236 ✓。
    #   改为弹性献金：目标 5 次，金币不足时优雅停止（不再 return 1 硬中止）。
    print()
    print('--- V94 46F 祭坛冲攻 → 25F 大法师 obj96 → 5 红钥 ---')
    #   无需再 goto_stair_adj + fly(46) 飞回（原从 48F 返回）。祭坛(6,1)由 altar_uses 自行 goto。
    if os.environ.get('MOTA_PROBE_46'):
        _dump_floor(w, 46)
    if not altar_uses(w, 6, 1, 4, 'atk', 'V94'): return 1
    if not goto_stair_adj(w, 'V94'):
        print('  !! V94 46F 无梯旁可站' % h.f); return 1
    if not fly(w, 25, 'V94 飞 25F'): return 1
    if not goto(w, 6, 10, 'V94 25F (6,10) 落穴通过（dyn_raw 记 obj20，非红门）'): return 1
    if not goto(w, 6, 6, 'V94 大法师 obj96（HP4500/ATK560/DEF310）'): return 1
    # 击杀后 5 把红钥摆在 row8 (4,8)~(8,8)，(6,8) 路过已拾，补齐其余 4 把
    for (kx, ky) in ((6, 8), (5, 8), (4, 8), (7, 8), (8, 8)):
        if not goto(w, kx, ky, 'V94 红钥(%d,%d)' % (kx, ky)):
            print('  !! V94 红钥(%d,%d) 不可达' % (kx, ky))
    print('   V94 完成（大法师击破，红钥到手）: %s' % st(h))

    # ---------- V95: 26F 假公主（x6 竖列 4 红门 → (6,7) 触发 story26 → 挖开 24F 竖井）----------
    #   红钥 6 把充裕（4 门 + 24F 1 门 = 5 ≤ 6），直接开满 4 道，不折腾雪之结晶绕 (6,8)。
    #   (6,7) 既是第 4 道红门，又是剧情触发格：开门后踩上去即触发。
    print()
    print('--- V95 26F 假公主（4 红门 → (6,7) 触发 → 24F 竖井）---')
    if not goto_stair_adj(w, 'V95'):
        print('  !! V95 %dF 无梯旁可站' % h.f); return 1
    if not fly(w, 26, 'V95 飞 26F'): return 1
    for (dx, dy, lab) in ((6, 10, '红门(6,10)'), (6, 9, '红门(6,9)'),
                          (6, 8, '红门(6,8)'), (6, 7, '红门(6,7)+假公主触发')):
        if not goto(w, dx, dy, 'V95 %s' % lab): return 1
    if not getattr(w, 'story26', False):
        print('  !! V95 假公主剧情未触发'); return 1
    print('   V95 完成（26F 假公主，24F 竖井已挖开）: %s' % st(h))

    # ---------- V96: 24F 竖井 → (6,0) 触发 ending → 50F ----------
    #   24F 红门 (6,8) 必经（BFS 实测）→ -1 红。竖井 (6,0) 在 y=0（越出 1-11 导航范围），
    #   先 goto (6,1) 再手动上一步踩 (6,0)，由 move() 内的 TRIG_24F_END 触发 ending → 传 50F(6,7)。
    print()
    print('--- V96 24F 竖井 → (6,0) ending → 50F ---')
    if not goto_stair_adj(w, 'V96'):
        print('  !! V96 %dF 无梯旁可站' % h.f); return 1
    if not fly(w, 24, 'V96 飞 24F'): return 1
    if not goto(w, 6, 8, 'V96 24F 红门(6,8) -1红'): return 1
    if not goto(w, 6, 1, 'V96 24F(6,1) 竖井口'): return 1
    ok, lg = _step(w, (0, -1))
    if not ok:
        print('  !! V96 踏入 (6,0) 失败: %s' % lg); return 1
    for _m in lg:
        print('     · ' + _m)
    if not getattr(w, 'story24_end', False):
        print('  !! V96 ending 未触发'); return 1
    print('   V96 完成（ending → 50F）: %s' % st(h))

    # ---------- V97: 50F 真魔王 obj57（封印后 800/500/100）----------
    print()
    print('--- V97 50F 真魔王 obj57 ---')
    if not goto(w, 6, 5, 'V97 50F(6,5) 真魔王 obj57（封印后 800/500/100）'): return 1
    if not getattr(w, 'won50', False):
        print('  !! V97 真魔王未击败'); return 1
    print('   ★★★ 通关（真魔王击破）★★★ %s' % st(h))
    # 圣水 obj104 本路线未持有（16F 老人需 1 黄钥，与 46F 祭坛门槛冲突）；
    #   与魔法钥匙同样处理：不调用、不输出警告。
    print('   V97 完成（通关）: %s' % st(h))
    return 0

def _audit_remaining_loot(w):
    """扫全图未拾取属性来源（ATK/DEF/HP 道具 + 可再祭坛），反推大法师缺口。"""
    h = w.hero
    from collections import defaultdict
    remain = defaultdict(lambda: [0, 0, 0, []])  # floor -> [hp,atk,dfn, cells]
    for f in range(1, 51):
        if f == 0:
            continue
        for y in range(1, 12):
            for x in range(1, 12):
                o = w.at(f, x, y)
                if not o:
                    continue
                if (f, x, y) in w.cleared:
                    continue
                hp, atk, dfn = M.oatr(o, 10), M.oatr(o, 11), M.oatr(o, 12)
                if hp or atk or dfn:
                    remain[f][0] += hp; remain[f][1] += atk; remain[f][2] += dfn
                    remain[f][3].append((x, y, o, hp, atk, dfn))
    print('\n=== 未拾取属性来源审计（V92 后）===')
    print('当前: %s  altar_k=%d  gold=%d' % (st(h), w.altar_k, h.gold))
    tot = [0, 0, 0]
    for f in sorted(remain):
        r = remain[f]
        tot[0] += r[0]; tot[1] += r[1]; tot[2] += r[2]
        print('  %2dF  HP+%4d ATK+%3d DEF+%3d  格:%s' % (
            f, r[0], r[1], r[2],
            ['(%d,%d)o%d+%d/%+d/%+d' % (x, y, o, hp, atk, dfn) for (x, y, o, hp, atk, dfn) in r[3]]))
    print('  合计未拾取: HP+%d ATK+%d DEF+%d' % (tot[0], tot[1], tot[2]))
    # 四祭坛剩余可加（按当前 altar_k 向上推 30 次，列出累计与花费）
    print('\n=== 祭坛增益档位（每楼层固定，不随 k 缩放；仅 HP 随 k 缩放）===')
    print('  4F +2攻/+4防 | 12F +4攻/+8防 | 32F +8攻/+16防 | 46F +10攻/+20防')
    print('  代价随全局已祭 k 递增: 20/40/80/140/220/320/440/580/740/920/1120/1340/1580...')
    # 大法师战损试算
    print('\n=== 大魔導師 obj96 (HP4500 ATK560 DEF310) 战损试算 ===')
    def loss_ma(A, D):
        per = A - 310
        if per <= 0:
            return None
        t = -(-4500 // per)
        return (560 - D) * (t - 1)
    for A in (348, 450, 500, 560, 600, 700, 800, 1000):
        for D in (337, 450, 500, 560, 600):
            L = loss_ma(A, D)
            if L is not None:
                print('    A%-4d D%-4d 战损=%s%s' % (A, D, L, ' (0伤!)' if L == 0 else ''))
        print()
    print('=== 50F 真魔王 obj57(封印后 800/500/100) 战损试算 ===')
    def loss_50(A, D):
        per = A - 100
        if per <= 0:
            return None
        t = -(-8000 // per)
        return (500 - D) * (t - 1)
    for A in (348, 500, 560, 600, 700, 800, 1000):
        for D in (337, 500, 560, 600):
            L = loss_50(A, D)
            if L is not None:
                print('    A%-4d D%-4d 战损=%s%s' % (A, D, L, ' (0伤!)' if L == 0 else ''))
        print()

if __name__ == '__main__':
    sys.exit(main())
