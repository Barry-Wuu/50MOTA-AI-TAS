        (2, 3, 'v 大バット+12'),
        (2, 2, '^ 回'),
        (3, 2, ''), (4, 2, ''), (5, 2, ''), (5, 3, 'ゾンビ+18'),
        # 中轴下行：ゾンビナイト(6,6)+30 → 双大バット(5,9)(7,9)+24
        (6, 3, ''), (6, 4, ''), (6, 5, ''), (6, 6, 'ゾンビナイト+30'),
        (6, 7, ''), (6, 8, ''), (6, 9, ''), (5, 9, '大バット+12'),
        (6, 9, ''), (7, 9, '大バット+12'),
