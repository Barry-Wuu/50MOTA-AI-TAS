    2953: getfield      #70                 // Field strMessage:[[Ljava/lang/String;
    2956: iconst_0
    2957: aaload
    2958: bipush        45
    2960: ldc_w         #634                // String The brave man says \"Huh? Hey! You\'re Zeno! Were you still alive ?\"
