    2941: getfield      #70                 // Field strMessage:[[Ljava/lang/String;
    2944: iconst_1
    2945: aaload
    2946: bipush        45
    2948: ldc_w         #633                // String 勇者「あっ！おまえはゼノッ！生きていたのか！？」
    2951: aastore
