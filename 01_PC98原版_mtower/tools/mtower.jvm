    2975: aastore
    2976: aload_0
    2977: getfield      #70                 // Field strMessage:[[Ljava/lang/String;
    2980: iconst_0
    2981: aaload
    2982: bipush        46
    2984: ldc_w         #636                // String The Magic Serg. Zeno says \"I will never die. I merely tested your intelligence as a soldier.\"
    2987: aastore
    2988: aload_0
    2989: getfield      #70                 // Field strMessage:[[Ljava/lang/String;
    2992: iconst_1
    2993: aaload
    2994: bipush        47
    2996: ldc_w         #637                // String 勇者「なにっ！？……どういうことだっ！どうして、こんな事を……！？」
    2999: aastore
    3000: aload_0
    3001: getfield      #70                 // Field strMessage:[[Ljava/lang/String;
    3004: iconst_0
