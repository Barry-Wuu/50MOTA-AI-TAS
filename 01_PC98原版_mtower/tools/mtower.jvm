    2740: iconst_0
    2741: aaload
    2742: bipush        36
    2744: ldc_w         #616                // String The Golden Knight says \"I will unwillingly forgive you this time. But we shall quarrel seriously when we meet again. You had better give up!\"
    2747: aastore
